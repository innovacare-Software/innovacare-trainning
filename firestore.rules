rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole(request.auth.uid) == "super_admin";
    }

    function requesterOrgId() {
      return isSignedIn() && hasUser(request.auth.uid)
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : null;
    }

    function sameRequesterOrg(orgId) {
      return isSignedIn() && requesterOrgId() != null && requesterOrgId() == orgId;
    }

    function isOrgMember(orgId) {
      // SECURITY (P3-Step 2): membership-based. Legacy users.orgId is no longer
      // sufficient by itself — the user MUST have an active membership in orgId.
      // super_admin is intentionally NOT counted as an org member here; callers
      // combine `isSuperAdmin() || isOrgMember(orgId)` when they want both.
      return membershipActive(orgId);
    }

    // --- Membership-based helpers (new multi-tenant model) ----------------
    // A membership document lives at /userOrgMemberships/{uid}__{orgId}
    // and authoritatively declares the role/status the user has within an org.
    function membershipPath(orgId) {
      return /databases/$(database)/documents/userOrgMemberships/$(request.auth.uid + "__" + orgId);
    }

    function hasMembership(orgId) {
      return isSignedIn() && exists(membershipPath(orgId));
    }

    function membershipRole(orgId) {
      return hasMembership(orgId) ? get(membershipPath(orgId)).data.role : "";
    }

    function membershipActive(orgId) {
      return hasMembership(orgId) && get(membershipPath(orgId)).data.status == "active";
    }

    function hasActiveMembershipRole(orgId, roles) {
      return membershipActive(orgId) && (membershipRole(orgId) in roles);
    }

    // Org admin / manager checks now require an explicit membership.
    // Legacy users.role values for "admin"/"manager" are NOT honored anymore
    // for org-scoped authorization — only super_admin keeps blanket powers.
    function isOrgAdmin(orgId) {
      return hasActiveMembershipRole(orgId, ["org_admin", "program_admin"]);
    }

    function isOrgManager(orgId) {
      return hasActiveMembershipRole(orgId, ["instructor", "org_admin", "program_admin"]);
    }

    // Read role from users/{uid} (informational legacy field — DO NOT use
    // for org-scoped authorization; use userOrgMemberships instead).
    function userRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : "";
    }

    // Platform-wide admin capability.
    // SECURITY (P3-Step 2): restricted to super_admin and the explicit
    // /admins/{uid} allow-list. Legacy roles (admin/manager/org_admin/
    // org_manager) NO LONGER grant blanket access — they must use the
    // membership-based helpers (isOrgAdmin/isOrgManager/canManageProgramOrg).
    function isAdmin() {
      return isSignedIn() && (
        userRole(request.auth.uid) == "super_admin"
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        )
      );
    }

    function targetUserOrgId(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.orgId
        : null;
    }

    function canManageUser(uid) {
      // SECURITY (P3-Step 2): require an active org_admin/program_admin
      // membership in the TARGET user's organization. Legacy users.role
      // checks have been removed.
      return isSuperAdmin()
        || isOwner(uid)
        || (
          isSignedIn()
          && hasUser(uid)
          && targetUserOrgId(uid) is string
          && isOrgAdmin(targetUserOrgId(uid))
        );
    }

    function canAssignLearner(uid) {
      // SECURITY (P3-Step 2): membership-based. Org admin or instructor in
      // the target's org may assign provided the target is a learner.
      return isSignedIn()
        && hasUser(uid)
        && targetUserOrgId(uid) is string
        && (
          isSuperAdmin()
          || isOrgManager(targetUserOrgId(uid))
        )
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ["learner", "org_learner"];
    }

    function hasOrgUser(orgId, uid) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(uid));
    }

    function sameUserActivationState() {
      return (
        request.resource.data.active == resource.data.active
        || (
          !('active' in resource.data)
          && !('active' in request.resource.data)
        )
      )
      && (
        request.resource.data.isActive == resource.data.isActive
        || (
          !('isActive' in resource.data)
          && !('isActive' in request.resource.data)
        )
      );
    }

    function sameUserOrgBinding() {
      return (
        request.resource.data.orgId == resource.data.orgId
        || (
          !('orgId' in resource.data)
          && !('orgId' in request.resource.data)
        )
      );
    }

    function hasOrgCourse(orgId, courseId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/courses/$(courseId));
    }

    // SECURITY (P3-Step 2): the legacy no-arg helpers `isProgramAdmin()`,
    // `isProgramStaff()` and `canManagePrograms()` have been REMOVED. They
    // granted authority based on global users.role flags which created
    // cross-tenant admin escalation. All program-management authorization
    // now goes through `canManageProgramOrg(orgId)` (membership-based).

      function canManageProgramOrg(orgId) {
        // SECURITY (P3-Step 2): membership-based. Requires either super_admin
        // or an ACTIVE program_admin/org_admin membership in the target org.
        // Legacy users.role + sameRequesterOrg() path has been removed.
        return isSuperAdmin()
          || (
            orgId is string
            && orgId.size() > 0
            && hasActiveMembershipRole(orgId, ["program_admin", "org_admin"])
          );
      }

      function programDocOrgId(programId) {
        return exists(/databases/$(database)/documents/programs/$(programId))
          ? get(/databases/$(database)/documents/programs/$(programId)).data.orgId
          : null;
      }

      function canManageProgramById(programId) {
        return programId is string
          && programId.size() > 0
          && canManageProgramOrg(programDocOrgId(programId));
      }

      function canReadManagedUserPrivateData(uid, orgId) {
        // SECURITY (P3-Step 2): membership-based. The reader must be either
        // super_admin, the owner, or hold an active org_admin/program_admin
        // membership in the data's orgId (with fallback to the target user's
        // stored orgId when the document carries no orgId).
        return isSuperAdmin()
          || (
            isSignedIn()
            && (
              (orgId is string && orgId.size() > 0 && isOrgAdmin(orgId))
              || (
                hasUser(uid)
                && targetUserOrgId(uid) is string
                && isOrgAdmin(targetUserOrgId(uid))
              )
            )
          );
      }

    function isProgramLearner() {
      return isSignedIn()
        && hasUser(request.auth.uid)
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProgramLearner == true
          || userRole(request.auth.uid) in ["guest", "learner"]
        );
    }

    function isClinician() {
      return isSignedIn() && (
        userRole(request.auth.uid) == "nurse"
        || userRole(request.auth.uid) == "lpn"
        || userRole(request.auth.uid) == "np"
        || userRole(request.auth.uid) == "caregiver"
      );
    }

    // Is current user the assignee of a given task object?
    function isAssignedTo(task) {
      return isSignedIn() && task.assignedTo == request.auth.uid;
    }

    // Allow only forward, safe status moves for clinicians
    // new -> assigned -> in_progress -> done|cancelled
    function statusTransitionOk(old, neu) {
      return
        (old == "new"         && neu in ["new","assigned"]) ||
        (old == "assigned"    && neu in ["assigned","in_progress","cancelled"]) ||
        (old == "in_progress" && neu in ["in_progress","done","cancelled"]) ||
        (old == "done"        && neu == "done") ||
        (old == "cancelled"   && neu == "cancelled");
    }

    function validPublicOfferPayload() {
      return request.resource.data.keys().hasOnly([
        'type','orgId','courseId','title','description','imageUrl',
        'price','currency','stripePriceId','isActive','isPublic',
        'createdAt','updatedAt','publishedBy'
      ])
      && request.resource.data.type == 'course'
      && request.resource.data.orgId is string
      && request.resource.data.orgId.size() > 0
      && request.resource.data.courseId is string
      && request.resource.data.courseId.size() > 0
      && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && (!('description' in request.resource.data) || request.resource.data.description is string)
      && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
      && request.resource.data.price is number
      && request.resource.data.price > 0
      && request.resource.data.currency is string
      && request.resource.data.currency.size() >= 3
      && request.resource.data.currency.size() <= 8
      && request.resource.data.stripePriceId is string
      && request.resource.data.stripePriceId.size() > 0
      && request.resource.data.isActive is bool
      && request.resource.data.isPublic is bool;
    }

    function canReadCommunicationOrg(orgId) {
      return isSuperAdmin() || (
        orgId is string
        && orgId.size() > 0
        && sameRequesterOrg(orgId)
        && requesterOrgId() is string
        && requesterOrgId().size() > 0
        && hasActiveMembershipRole(requesterOrgId(), ['org_admin', 'program_admin'])
      );
    }

    function canWriteCommunicationOrg(orgId) {
      return isSuperAdmin() || (
        orgId is string
        && orgId.size() > 0
        && sameRequesterOrg(orgId)
        && requesterOrgId() is string
        && requesterOrgId().size() > 0
        && hasActiveMembershipRole(requesterOrgId(), ['org_admin', 'program_admin'])
      );
    }

    function validCommunicationDraftSafety(data) {
      return data.keys().hasAll(['safety'])
        && data.safety is map
        && data.safety.mode == 'draft_only'
        && data.safety.mockOnly == true
        && data.safety.provider == 'none'
        && data.safety.canAutoSend == false;
    }

    function validCommunicationReadableSafety(data) {
      return validCommunicationDraftSafety(data)
        || (
          data.keys().hasAll(['safety'])
          && data.safety is map
          && data.safety.mode == 'live_send'
          && data.safety.mockOnly == false
          && data.safety.provider == 'sendgrid'
          && data.safety.canAutoSend == true
        );
    }

    function validCommunicationDraftWrite() {
      return request.resource.data.orgId is string
        && request.resource.data.orgId.size() > 0
        && validCommunicationDraftSafety(request.resource.data);
    }

    function validCommunicationDraftResource() {
      return resource.data.orgId is string
        && resource.data.orgId.size() > 0
        && validCommunicationReadableSafety(resource.data);
    }

    function isCommunicationDraftStatus(status) {
      return status == 'draft'
        || status == 'approval_pending'
        || status == 'approved'
        || status == 'archived';
    }

    function isApprovalPriority(priority) {
      return priority == 'low'
        || priority == 'normal'
        || priority == 'high'
        || priority == 'critical';
    }

    function validTemplateDraftWrite() {
      return request.resource.data.status is string
        && isCommunicationDraftStatus(request.resource.data.status);
    }

    function validSegmentDraftWrite() {
      return request.resource.data.status is string
        && isCommunicationDraftStatus(request.resource.data.status);
    }

    function validNewsletterDraftWrite() {
      return request.resource.data.status is string
        && isCommunicationDraftStatus(request.resource.data.status);
    }

    function validCampaignDraftWrite() {
      return request.resource.data.status is string
        && (
          request.resource.data.status == 'draft'
          || request.resource.data.status == 'approval_pending'
          || request.resource.data.status == 'approved'
          || (
            request.resource.data.status == 'scheduled'
            && request.resource.data.scheduledAt is string
            && resource != null
            && resource.data.status == 'approved'
          )
        );
    }

    function validApprovalDraftWrite() {
      return request.resource.data.status is string
        && (
          request.resource.data.status == 'pending'
          || request.resource.data.status == 'approved'
          || request.resource.data.status == 'rejected'
        )
        && request.resource.data.priority is string
        && isApprovalPriority(request.resource.data.priority);
    }

    function validAuditDraftWrite() {
      return request.resource.data.actionType is string
        && (
          request.resource.data.actionType == 'draft_created'
          || request.resource.data.actionType == 'draft_updated'
          || request.resource.data.actionType == 'approval_requested'
          || request.resource.data.actionType == 'approval_decision'
          || request.resource.data.actionType == 'preview_generated'
        );
    }

    // ---------- Small utils ----------
    function hasOnlyKeys(m, keys) {
      return m.keys().hasOnly(keys);
    }

    function isString(x) {
      return x is string;
    }

    function isBool(x) {
      return x is bool;
    }

    function isNumber(x) {
      return x is number;
    }

    // ---------- Validators from merged rules ----------
    function validCourse(d) {
      return hasOnlyKeys(d, [
        'title','subtitle','description','lang','durationMin','ceCredit',
        'active','tags','imageUrl','createdAt','updatedAt','kind','sections','url','code',
        'type','level','lecturer','disclosures','targetAudience','prerequisites',
        'requirements','accomodations','passingScore','lockedSequence','isPublic',
        'publicPrice','publicCurrency','stripePriceId','stripeProductId',
        'orgId','orgType','healthMeta','releaseAt','publishedAt','exipirationDate',
        'confirmAt','confirmBy','confirmMessage'
      ])
      && isString(d.title)
      && isString(d.description)
      && isString(d.lang)
      && isNumber(d.durationMin)
      && isBool(d.active)
      && isString(d.kind)
      && (!('subtitle' in d) || isString(d.subtitle))
      && (!('ceCredit' in d) || isNumber(d.ceCredit))
      && (!('tags' in d) || d.tags is list)
      && (!('imageUrl' in d) || isString(d.imageUrl))
      && (!('sections' in d) || d.sections is list)
      && (!('url' in d) || isString(d.url))
      && (!('code' in d) || isString(d.code))
      && (!('type' in d) || isString(d.type))
      && (!('level' in d) || isString(d.level))
      && (!('lecturer' in d) || isString(d.lecturer))
      && (!('disclosures' in d) || d.disclosures is list)
      && (!('targetAudience' in d) || d.targetAudience is list)
      && (!('prerequisites' in d) || d.prerequisites is list)
      && (!('requirements' in d) || d.requirements is list)
      && (!('accomodations' in d) || isString(d.accomodations))
      && (!('passingScore' in d) || isNumber(d.passingScore))
      && (!('lockedSequence' in d) || isBool(d.lockedSequence))
      && (!('isPublic' in d) || isBool(d.isPublic))
      && (!('publicPrice' in d) || isNumber(d.publicPrice))
      && (!('publicCurrency' in d) || isString(d.publicCurrency))
      && (!('stripePriceId' in d) || isString(d.stripePriceId))
      && (!('stripeProductId' in d) || isString(d.stripeProductId))
      && (!('orgId' in d) || d.orgId == null || isString(d.orgId))
      && (!('orgType' in d) || isString(d.orgType))
      && (!('healthMeta' in d) || d.healthMeta is map)
      && (!('releaseAt' in d) || d.releaseAt is timestamp)
      && (!('publishedAt' in d) || d.publishedAt is timestamp)
      && (!('exipirationDate' in d) || d.exipirationDate is timestamp)
      && (!('confirmAt' in d) || d.confirmAt is timestamp)
      && (!('confirmBy' in d) || isString(d.confirmBy))
      && (!('confirmMessage' in d) || isString(d.confirmMessage));
    }

    function validCert(d) {
      return hasOnlyKeys(d, ['code','name','credit'])
        && isString(d.code)
        && isString(d.name)
        && isString(d.credit);
    }

    function validExam(d) {
      return hasOnlyKeys(d, ['title','questions','available','url','createdAt','updatedAt','passPct'])
        && isString(d.title)
        && isNumber(d.questions)
        && d.questions >= 1
        && isBool(d.available)
        && (!('url' in d) || isString(d.url));
    }

    function validWound(d) {
      return hasOnlyKeys(d, [
        'id','name','aliases','category','stage','definition','pathophysiology',
        'clinical_features','common_sites','risk_factors','assessment','interventions',
        'topical_treatments','expected_healing_time','documentation_example',
        'prevention','images','references','tags','createdAt','updatedAt','locale'
      ])
      && (d.id is string)
      && (d.name is string)
      && (d.definition is string);
    }

    // ---------- VALIDATORS FOR COMMON MODELS ----------
    function validPolicy(d) {
      return (d.title is string && d.title.size() > 0)
        && (d.content is string && d.content.size() > 0)
        && (d.version is string || d.version is number)
        && (d.createdAt is timestamp)
        && ((!('updatedAt' in d)) || d.updatedAt is timestamp);
    }

    // ---------- Admin allow-list doc ----------
    match /admins/{uid} {
      allow read, write: if false; // managed server-side/console only
    }

    // ---------- USERS ----------
    match /users/{uid} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid)
        || (
          // SECURITY (P3-Step 2): membership-based. Reader must hold an active
          // org_admin/program_admin membership in the target user's org.
          isSignedIn()
          && resource.data.orgId is string
          && isOrgAdmin(resource.data.orgId)
        );

      // super_admin full control
      // org admin can manage users of their org only via active membership
      // self-write cannot change role/orgId/active
      allow create: if isSuperAdmin()
        || (
          // SECURITY (P3-Step 2): creator must hold an active org_admin/
          // program_admin membership in the target org. Legacy global admin
          // role checks have been removed.
          isSignedIn()
          && request.resource.data.orgId is string
          && isOrgAdmin(request.resource.data.orgId)
          && request.resource.data.role in ["admin", "manager", "org_admin", "org_manager", "learner", "org_learner", "guest"]
        )
        // SECURITY: a self-created profile (public signup) MUST stay org-less.
        // It can only become attached to an org via a userOrgMembership written
        // by a super_admin. We no longer accept the legacy public-org id here:
        // any pre-assignment to a real org from the client side is a tenant leak.
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "guest"
          && (
            !('orgId' in request.resource.data)
            || request.resource.data.orgId == null
          )
        );

      allow update: if isSuperAdmin()
        || (
          // SECURITY (P3-Step 2): updater must hold an active org_admin/
          // program_admin membership in the target user's org and the orgId
          // assignment cannot be changed (only super_admin can move a user
          // across orgs).
          isSignedIn()
          && resource.data.orgId is string
          && isOrgAdmin(resource.data.orgId)
          && request.resource.data.orgId == resource.data.orgId
          && request.resource.data.role in ["admin", "manager", "org_admin", "org_manager", "learner", "org_learner", "guest"]
        )
        || (
          isSignedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && sameUserOrgBinding()
          && sameUserActivationState()
        );

      allow delete: if isSuperAdmin();
    }

    // ---------- USER ORG MEMBERSHIPS (multi-tenant authorization source) ----------
    // Each document id is `${userId}__${orgId}`. The role/status here is the
    // authoritative source of truth for org-scoped admin powers. Only the
    // super_admin can write; the membership owner and org admins of the same
    // org can read.
    match /userOrgMemberships/{membershipId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && isOrgAdmin(resource.data.orgId));

      allow create, update, delete: if isSuperAdmin();
    }

    // ---------- ORGANIZATIONS (multi-tenant boundary) ----------
    match /organizations/{orgId} {
      // Needed for organization-code login lookup; only active orgs are visible publicly.
      allow read: if ((!('active' in resource.data)) || resource.data.active == true)
        || isSuperAdmin()
        || isOrgMember(orgId)
        || isOrgAdmin(orgId);

      allow create, update, delete: if isSuperAdmin();

      match /orgUsers/{uid} {
        allow read: if isSuperAdmin() || isOrgMember(orgId) || isOrgAdmin(orgId);
        allow create, update, delete: if false;
      }

      // ---------- STRICT ORG-SCOPED DOMAIN ----------
      match /users/{uid} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && request.auth.uid == uid);

        allow create, update: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow delete: if isSuperAdmin() || isOrgAdmin(orgId);
      }

      // Canonical path for courses assigned by platform to organization.
      match /assignedCourses/{courseId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        // Platform owner assigns courses to organizations.
        allow create, update, delete: if isSuperAdmin();
      }

      // Backward compatibility path.
      match /courses/{courseId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin();
      }

      match /courseAssignments/{assignmentId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);

        // Org admin/manager can assign only approved org courses to users of same org.
        allow create: if isSuperAdmin()
          || (
            (isOrgAdmin(orgId) || isOrgManager(orgId))
            && request.resource.data.orgId == orgId
            && request.resource.data.userId is string
            && hasOrgUser(orgId, request.resource.data.userId)
            && request.resource.data.courseId is string
            && (
              hasOrgCourse(orgId, request.resource.data.courseId)
              || exists(/databases/$(database)/documents/organizations/$(orgId)/assignedCourses/$(request.resource.data.courseId))
            )
          );

        allow update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /enrollments/{enrollmentId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /progress/{progressId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && request.resource.data.userId == request.auth.uid);

        allow delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /overdue/{recordId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /policies/{policyId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /policyAcknowledgments/{ackId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && request.resource.data.userId == request.auth.uid);

        allow delete: if isSuperAdmin() || isOrgAdmin(orgId);
      }

      match /woundLibrary/{itemId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /documents/{documentId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId);
      }

      match /reports/{reportId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /alerts/{alertId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.assignedTo == request.auth.uid);

        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /followUpActions/{actionId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.assignedTo == request.auth.uid);

        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /auditLogs/{logId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow create: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow update, delete: if false;
      }

      match /troubleshootingIssues/{issueId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /examPrograms/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /examCourseGroups/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /examModules/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /questionBank/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /caseStudies/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /examBlueprints/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /assessmentDefinitions/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /jurisdictionOverlays/{docId} {
        allow read, create, update, delete: if canManageProgramOrg(orgId);
      }

      match /attemptSessions/{docId} {
        allow read: if canManageProgramOrg(orgId)
          || (isSignedIn() && hasMembership(orgId) && resource.data.learnerId == request.auth.uid);
        allow create, update: if canManageProgramOrg(orgId);
        allow delete: if false;

        match /events/{eventId} {
          allow read: if canManageProgramOrg(orgId)
            || (
              isSignedIn()
              && hasMembership(orgId)
              && get(/databases/$(database)/documents/organizations/$(orgId)/attemptSessions/$(docId)).data.learnerId == request.auth.uid
            );
          allow create, update, delete: if false;
        }
      }

      match /attemptReviewSnapshots/{docId} {
        allow read: if canManageProgramOrg(orgId)
          || (isSignedIn() && hasMembership(orgId) && resource.data.learnerId == request.auth.uid);
        allow create, update: if canManageProgramOrg(orgId);
        allow delete: if false;
      }
    }

    // Legacy path compatibility: /org/{orgId}/orgUsers/{uid}
    match /org/{orgId}/orgUsers/{uid} {
      allow read: if isSuperAdmin() || isOrgMember(orgId) || isOrgAdmin(orgId);
      allow create, update, delete: if false;
    }

    match /organizationCourseAssignments/{assignmentId} {
      allow read: if isSuperAdmin()
        || (resource.data.orgId is string && isOrgMember(resource.data.orgId));

      allow create, update, delete: if isSuperAdmin();
    }

    match /adminLogs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ---------- USER COMMERCE DATA (owner-read, sensitive server-write) ----------
    match /users/{uid}/carts/{cartId} {
        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/orders/{orderId} {
        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if canReadManagedUserPrivateData(resource.data.userId, resource.data.orgId);
      allow create, update, delete: if false;
    }

    match /users/{uid}/guestEnrollments/{enrollmentId} {
        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    match /users/{uid}/guestPrograms/{programAccessId} {
        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    match /users/{uid}/bookings/{bookingId} {
        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/programLiveSessionBookings/{bookingId} {
        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/notificationReads/{notificationId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin() || isOwner(uid);
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read: if canManageUser(uid);
      allow update: if canManageUser(uid);
      allow create: if false;
      allow delete: if isSuperAdmin() || isOwner(uid);
    }

    match /users/{uid}/preferences/{preferenceId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin() || isOwner(uid);
    }

    match /users/{uid}/licenses/{licenseId} {
      allow read: if canManageUser(uid);
      allow create, update, delete: if canManageUser(uid);
    }

    match /users/{uid}/enrollments/{courseId} {
      allow read: if canManageUser(uid);
      allow create, update: if isSuperAdmin() || isOwner(uid) || canAssignLearner(uid);
      allow delete: if isSuperAdmin();
    }

    match /users/{uid}/launchTickets/{ticketId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin() || isOwner(uid);
    }

    match /users/{uid}/wallet/{walletId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin();
    }

    match /users/{uid}/rewards/{rewardId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin();
    }

    // ---------- LEARNER ASSISTANT (chat) ----------
    // Owner-scoped chat sessions and messages.
    // Generation + usage accounting are performed by the
    // `learnerAssistantChat` callable using admin SDK.
    match /users/{uid}/assistantSessions/{sessionId} {
      allow read: if isOwner(uid) || canManageUser(uid);
      allow create, update: if isOwner(uid);
      allow delete: if isSuperAdmin() || isOwner(uid);

      match /messages/{messageId} {
        allow read: if isOwner(uid) || canManageUser(uid);
        // Owner can append their own user messages from the client.
        // Assistant replies are written by the backend (admin SDK bypasses rules).
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    match /users/{uid}/assistantUsage/{day} {
      allow read: if isOwner(uid) || canManageUser(uid);
      // Backend-only writes via admin SDK.
      allow write: if false;
    }

    // ---------- SERVICES (public read; admin write) ----------
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(
            ['title','slug','active','blurb','bullets','category','image','duration','order']
           )
        && (request.resource.data.title is string)
        && (request.resource.data.slug is string)
        && (request.resource.data.active is bool);
    }

    // ---------- COURSES & OFFERS (public catalogue read) ----------
    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && validCourse(request.resource.data);
      allow delete: if isSuperAdmin();

      match /certifications/{id} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSuperAdmin() && validCert(request.resource.data);
      }

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      match /exams/{examId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSuperAdmin() && validExam(request.resource.data);

        match /questions/{questionId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isSuperAdmin();
        }

        match /answerKey/{questionId} {
          allow read, create, update, delete: if isSuperAdmin();
        }
      }
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // ---------- EVENTS & REGISTRATIONS ----------
    match /events/{eventId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Only admins can create/update/delete
      allow create, update, delete: if isAdmin();

      match /registrations/{uid} {
        // Admin or owner can read
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        // Owner can self-register
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == uid;
        // Admin or owner can delete
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        // No updates allowed
        allow update: if false;
      }
    }

    // ---------- TIMESHEETS & ENTRIES ----------
    match /timesheets/{tsId} {
      function belongsTo(uid) { return isSignedIn() && tsId.split('_')[0] == uid; }

      allow read: if isSignedIn() && (belongsTo(request.auth.uid) || isAdmin());
      allow create: if isSignedIn() && belongsTo(request.auth.uid);

      allow update: if isSignedIn() && (
        (belongsTo(request.auth.uid) &&
          !('approvedAt' in request.resource.data) &&
          !('approvedBy' in request.resource.data)) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['status','approvedAt','approvedBy','updatedAt','totalHours']))
      );
      allow delete: if isAdmin();

      match /entries/{entryId} {
        allow read: if isSignedIn() && (belongsTo(request.auth.uid) || isAdmin());
        allow create, update: if isSignedIn() && (
          (belongsTo(request.auth.uid) &&
            (get(/databases/$(database)/documents/timesheets/$(tsId)).data.status in ['open','submitted'])) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ---------- NOTIFICATIONS (consolidated) ----------
    match /notifications/{notificationId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /demoRequests/{requestId} {
      allow create: if request.time < timestamp.date(2099,1,1)
        && request.resource.data.keys().hasOnly([
          'fullName',
          'workEmail',
          'phone',
          'organizationName',
          'organizationType',
          'selectedPlan',
          'message',
          'source',
          'status',
          'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.workEmail is string
        && request.resource.data.workEmail.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.organizationName is string
        && request.resource.data.organizationType is string
        && request.resource.data.selectedPlan is string
        && request.resource.data.message is string
        && request.resource.data.source is string
        && request.resource.data.status == 'new';

      allow read, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /billingRecords/{recordId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.uid is string
          && canManageUser(resource.data.uid)
        )
        || (
          // Automation v1 writes `userId` instead of `uid` — let the learner
          // read their own certificate without going through the callable.
          isSignedIn()
          && resource.data.userId is string
          && request.auth.uid == resource.data.userId
        )
        || (
          // Org admins can read certificates issued under their organization.
          resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && isOrgAdmin(resource.data.orgId)
        );

      allow create, update: if isSuperAdmin()
        || (
          isSignedIn()
          && request.resource.data.uid is string
          && canManageUser(request.resource.data.uid)
        );

      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────
    // Enrollments (automation v1 — top-level collection)
    // ──────────────────────────────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      // Writes go through Cloud Functions (admin SDK bypasses these rules):
      // createCheckoutSession → stripeWebhook → handleAutomationCheckoutCompleted.
      allow create: if false;

      allow read: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.userId is string
          && request.auth.uid == resource.data.userId
        )
        || (
          resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && isOrgAdmin(resource.data.orgId)
        );

      // The learner can flip status from "active" to "completed" so the
      // onEnrollmentCompleted trigger picks it up. Everything else is
      // server-only.
      allow update: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.userId is string
          && request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'progress', 'updatedAt'])
          && request.resource.data.status in ['active', 'completed']
        );

      allow delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────
    // Organization settings (per-org configuration documents)
    // ──────────────────────────────────────────────────────────────────
    match /orgSettings/{orgId} {
      allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      allow write: if isSuperAdmin() || isOrgAdmin(orgId);
    }

    match /communication_templates/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validTemplateDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validTemplateDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletters/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validNewsletterDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validNewsletterDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_campaigns/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validCampaignDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validCampaignDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_recipients/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_events/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_analytics/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_segments/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validSegmentDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validSegmentDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_automations/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_approvals/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validApprovalDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validApprovalDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_audits/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validAuditDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validAuditDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    // ──────────────────────────────────────────────────────────────────
    // Lead capture (public marketing form → triage by org admins)
    // ──────────────────────────────────────────────────────────────────
    match /leadCapture/{leadId} {
      // Anyone (signed in or not) may submit a lead, but the payload must
      // look like a lead and cannot pre-set internal fields.
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'phone', 'email', 'country', 'interest',
            'source', 'orgId', 'createdAt', 'status',
          ])
        && (request.resource.data.email is string
            || request.resource.data.phone is string)
        && request.resource.data.status == 'new';
      allow read, update: if isSuperAdmin()
        || (
          resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && (isOrgAdmin(resource.data.orgId) || isOrgManager(resource.data.orgId))
        );
      allow delete: if isSuperAdmin();
    }

    match /publicOffers/{offerId} {
      allow read: if (resource.data.isActive == true && resource.data.isPublic == true)
        || sameRequesterOrg(resource.data.orgId)
        || isAdmin();
      allow create: if isSuperAdmin() && validPublicOfferPayload();
      allow update: if isSuperAdmin()
        && validPublicOfferPayload()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSuperAdmin();
    }

    // ---------- WOUND LIBRARY ----------
    match /woundLibrary/{docId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Only admins can create/update/delete
      allow create, update: if isSuperAdmin() && validWound(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /wounds/{docId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Only admins can create/update/delete
      allow create, update: if isSuperAdmin() && validWound(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ---------- COURSE ASSIGNMENTS ----------
    match /courseAssignments/{docId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // SECURITY (P3-Step 2): super_admin OR an active org_admin/program_admin
      // membership in the target learner's org. Legacy users.role checks have
      // been removed.
      allow create, update, delete: if isSuperAdmin()
        || (
          isSignedIn()
          && (
            (
              request.resource.data.userId is string
              && hasUser(request.resource.data.userId)
              && targetUserOrgId(request.resource.data.userId) is string
              && isOrgAdmin(targetUserOrgId(request.resource.data.userId))
              && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.role == "learner"
            )
            ||
            (
              resource.data.userId is string
              && hasUser(resource.data.userId)
              && targetUserOrgId(resource.data.userId) is string
              && isOrgAdmin(targetUserOrgId(resource.data.userId))
              && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.role == "learner"
            )
          )
        );
    }

    // ---------- PROGRAMS ----------
    match /programs/{programId} {
      allow read: if (
          resource.data.active == true
          && resource.data.status == "PUBLISHED"
        )
          || (
            isSignedIn()
            && resource.data.orgId is string
            && resource.data.orgId.size() > 0
            && sameRequesterOrg(resource.data.orgId)
          )
          || canManageProgramOrg(resource.data.orgId);

        allow create: if canManageProgramOrg(request.resource.data.orgId)
          && request.resource.data.orgId is string
          && request.resource.data.orgId.size() > 0;

        allow update: if canManageProgramOrg(resource.data.orgId)
          && resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && request.resource.data.orgId == resource.data.orgId;

        allow delete: if canManageProgramOrg(resource.data.orgId)
          && resource.data.orgId is string
          && resource.data.orgId.size() > 0;

      match /modules/{moduleId} {
        allow read: if (
            get(/databases/$(database)/documents/programs/$(programId)).data.active == true
            && get(/databases/$(database)/documents/programs/$(programId)).data.status == "PUBLISHED"
          )
            || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }

      match /lessons/{lessonId} {
        allow read: if (
            get(/databases/$(database)/documents/programs/$(programId)).data.active == true
            && get(/databases/$(database)/documents/programs/$(programId)).data.status == "PUBLISHED"
          )
            || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }

      match /simulations/{simulationId} {
          allow read: if isProgramLearner() || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }

      match /caseStudies/{caseStudyId} {
          allow read: if isProgramLearner() || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }

      match /assessments/{assessmentId} {
          allow read: if isProgramLearner() || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }

      match /documents/{documentId} {
          allow read: if isProgramLearner() || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }

      match /liveSessions/{sessionId} {
          allow read: if isProgramLearner() || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }

      match /resources/{resourceId} {
          allow read: if isProgramLearner() || canManageProgramById(programId);
          allow create, update, delete: if canManageProgramById(programId);
      }
    }

    match /programEnrollments/{enrollmentId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'programId',
          'userId',
          'programTitle',
          'category',
          'learnerName',
          'learnerEmail',
          'learnerPhone',
          'notes',
          'status',
          'amount',
          'currency',
          'paymentStatus',
          'reviewStatus',
          'enrolledAt',
          'activatedAt',
          'completedAt',
          'orgId',
          'createdAt',
          'updatedAt'
        ])
        && isOwner(request.resource.data.userId)
        && request.resource.data.programId is string
        && request.resource.data.programTitle is string
        && request.resource.data.learnerName is string
        && request.resource.data.learnerEmail is string
        && request.resource.data.learnerPhone is string
        && request.resource.data.orgId == programDocOrgId(request.resource.data.programId)
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.reviewStatus == 'pending_review';

      allow read: if canManageProgramOrg(resource.data.orgId)
        || canManageProgramById(resource.data.programId)
        || isOwner(resource.data.userId);

      allow update: if (
          canManageProgramOrg(resource.data.orgId)
          || canManageProgramById(resource.data.programId)
          || (
            isOwner(resource.data.userId)
            && resource.data.status == 'pending'
            && resource.data.paymentStatus in ['unpaid', 'pending']
          )
        )
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.programId == resource.data.programId
        && request.resource.data.programTitle == resource.data.programTitle
        && request.resource.data.status in ['pending', 'approved', 'active', 'completed', 'cancelled', 'rejected']
        && request.resource.data.paymentStatus in ['unpaid', 'pending', 'paid', 'refunded']
        && request.resource.data.reviewStatus in ['pending_review', 'approved', 'denied'];

      allow delete: if canManageProgramOrg(resource.data.orgId)
        || canManageProgramById(resource.data.programId);
    }

    match /programSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /users/{uid}/programProgress/{programId} {
        allow read: if canManageProgramById(programId) || isOwner(uid);
        allow create, update: if canManageProgramById(programId) || isOwner(uid);
        allow delete: if canManageProgramById(programId);
    }

    match /users/{uid}/moduleProgress/{moduleId} {
        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);
        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);
        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);
    }

    match /users/{uid}/simulationAttempts/{attemptId} {
        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);
        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);
        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);
    }

    match /users/{uid}/assessmentAttempts/{attemptId} {
        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);
        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);
        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);
    }

    match /users/{uid}/lessonProgress/{lessonId} {
        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);
        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);
        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);
    }

    match /users/{uid}/caseStudyAttempts/{attemptId} {
        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);
        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);
        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);
    }

    // ---------- POLICIES (read by all authenticated; write by admin/manager) ----------
    match /policies/{policyId} {
      // Authenticated users can read all policies
      allow read: if request.auth != null;
      // Only admins can create/update with validation
      allow create: if isSuperAdmin() && validPolicy(request.resource.data);
      allow update: if isSuperAdmin() && validPolicy(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Singular alias for compatibility (both /policies and /policy point to same business logic)
    match /policy/{policyId} {
      // Authenticated users can read all policies
      allow read: if request.auth != null;
      // Only admins can create/update with validation
      allow create: if isSuperAdmin() && validPolicy(request.resource.data);
      allow update: if isSuperAdmin() && validPolicy(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ---------- LISTENING TEST ENGINE ----------
    match /listeningTestAssessments/{assessmentId} {
      // Learners can read published tests; instructors can read/write all
      allow read: if isSignedIn() && (
        resource.data.status == 'PUBLISHED'
        || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /listeningTestResults/{resultId} {
      // Learner can create their own result
      allow create: if isSignedIn()
        && request.resource.data.learnerId == request.auth.uid;
      // Learner or admin can read
      allow read: if isSignedIn() && (
        resource.data.learnerId == request.auth.uid
        || isAdmin()
      );
      // Learner can update own result (error log); admin can update anything
      allow update: if isSignedIn() && (
        (resource.data.learnerId == request.auth.uid)
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /users/{uid}/listeningProgress/{assessmentId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /policy_acknowledgements/{ackId} {
        allow read: if (isSignedIn() && resource.data.userId is string && canManageUser(resource.data.userId))
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- PATHWAY REQUESTS ----------
    match /pathwayRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'courseId',
          'courseTitle',
          'source',
          'status',
          'requesterUid',
          'addedAt'
        ])
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() > 0
        && request.resource.data.courseTitle is string
        && request.resource.data.courseTitle.size() > 0
        && request.resource.data.source is string
        && request.resource.data.status == 'new'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.addedAt is timestamp;

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.requesterUid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // ---------- CONTACTS (public create; admin read/update) ----------
    match /contacts/{doc} {
      allow create: if request.auth == null
        && request.time < timestamp.date(2099,1,1)
        && request.resource.data.keys().hasOnly(
             ['name','email','phone','reason','message','createdAt','status','userAgent','page']
           )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

   // ---------- BOOKINGS (public create; admin read/update) ----------
match /bookings/{doc} {
  // Allow any visitor (signed-in or not) to create a booking
  allow create: if
      (request.auth == null || request.auth != null)
      && request.time < timestamp.date(2099,1,1)
      // If you enable App Check, uncomment next line:
      // && request.appcheck.token != null
      // Only allow the exact schema your client sends
      && request.resource.data.keys().hasOnly([
           'serviceSlug','serviceTitle',
           'patient','preference','contact',
           'status','createdAt','userAgent'
         ])
      // Validate nested shapes
      && request.resource.data.patient.keys().hasOnly([
           'firstName','lastName','dob','woundType','notes'
         ])
      && request.resource.data.preference.keys().hasOnly([
           'mode','preferredDate','preferredTime','address'
         ])
      && request.resource.data.contact.keys().hasOnly([
           'name','phone','email','refSource'
         ])
      // Initial status & createdAt must be "now"
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time;

  // Only admins can read/update bookings
  allow read, update: if isAdmin();

  // No deletes from clients
  allow delete: if false;
}



    // ---------- REFERRALS (public create; admin read/update) ----------
    match /patientReferal/{doc} {
      allow create: if request.auth == null
        && request.time < timestamp.date(2099,1,1)
        && request.resource.data.keys().hasOnly([
             'serviceSlug','serviceTitle',
             'refType','refName','refOrg','refRole','refEmail','refPhone',
             'patientName','patientDob','patientArea',
             'diagnosis','urgency','notes',
             'contactPref','consent',
             'createdAt','status','page','userAgent'
           ])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // ---------- TASKS & subcollections ----------
    // Task schema (canonical fields)
    // { createdAt, createdBy, source, patient, service, scheduledAt, status, assignedTo, notes, lastUpdatedAt }
    match /tasks/{taskId} {

      // Admin can read; clinician can read IF assigned
      allow read: if isAdmin() || (isClinician() && isAssignedTo(resource.data));

      // Admin creates tasks with strict schema
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'createdAt','createdBy','source','patient','service',
             'scheduledAt','status','assignedTo','notes','lastUpdatedAt'
           ])
        && (request.resource.data.status in ['new','assigned','in_progress','done','cancelled']);

      // Updates
      // - Admin: any update
      // - Clinician (assignee): can START (-> in_progress), progress, or mark DONE/CANCELLED.
      //   Immutable fields must stay identical.
      //   lastUpdatedAt must move forward.
      allow update: if isAdmin()
        || (
          isClinician()
          && isAssignedTo(resource.data)

          // Immutable fields unchanged by clinician
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.source     == resource.data.source
          && request.resource.data.patient    == resource.data.patient
          && request.resource.data['service'] == resource.data['service']
          && request.resource.data.createdBy  == resource.data.createdBy
          && request.resource.data.createdAt  == resource.data.createdAt

          // Only these fields may exist in clinician updates
          && request.resource.data.keys().hasOnly([
               'createdAt','createdBy','source','patient','service',
               'scheduledAt','status','assignedTo','notes','lastUpdatedAt'
             ])

          // Allowed status values + only forward transitions
          && (request.resource.data.status in ['assigned','in_progress','done','cancelled'])
          && statusTransitionOk(resource.data.status, request.resource.data.status)

          // Force a forward-moving timestamp on update
          && (request.resource.data.lastUpdatedAt > resource.data.lastUpdatedAt)
        );

      allow delete: if isAdmin();

      // ---- NOTES subcollection ----
      // Schema: { createdAt, authorUid, text, followUpAt? }
      match /notes/{noteId} {
        // Admin OR assigned clinician can read notes
        allow read: if isAdmin()
          || (isClinician()
              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));

        // Create: admin or assigned clinician; author must be current user
        allow create: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text','followUpAt'])
            && request.resource.data.authorUid == request.auth.uid
          );

        // Update: admin or original author clinician; createdAt/authorUid immutable
        allow update: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && (request.auth.uid == resource.data.authorUid)
            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text','followUpAt'])
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.createdAt == resource.data.createdAt
          );

        // Delete: admin or original author clinician
        allow delete: if isAdmin()
          || (
            isClinician()
            && (request.auth.uid == resource.data.authorUid)
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
          );
      }

      // ---- VISITS (optional) ----
      match /visits/{visitId} {
        allow read: if isAdmin()
          || (isClinician()
              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));

        allow create: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && request.resource.data.keys().hasOnly(
                 ['createdAt','nurseUid','start','end','notes','outcome','vitals']
               )
            && request.resource.data.nurseUid == request.auth.uid
          );

        allow update: if isAdmin()
          || (isClinician() && resource.data.nurseUid == request.auth.uid);

        allow delete: if isAdmin();
      }

      // ---- MESSAGES (optional) ----
      match /messages/{msgId} {
        allow read: if isAdmin()
          || (isClinician()
              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));
        allow create: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text'])
            && request.resource.data.authorUid == request.auth.uid
          );
        allow update, delete: if isAdmin()
          || (isSignedIn() && request.auth.uid == resource.data.authorUid);
      }
    }

    // Transactional notification pipeline collections
    match /notificationEvents/{eventId} {
      allow read: if isSuperAdmin()
        || (
          isAdmin()
          && resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && sameRequesterOrg(resource.data.orgId)
        )
        || (isSignedIn() && resource.data.recipientUserId == request.auth.uid);
      allow write: if false;
    }

    match /notificationTemplates/{templateId} {
      allow read: if isSuperAdmin() || isAdmin();
      allow write: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if isSuperAdmin()
        || (
          isAdmin()
          && resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && sameRequesterOrg(resource.data.orgId)
        )
        || (isSignedIn() && resource.data.recipientUserId == request.auth.uid);
      allow write: if false;
    }

    match /notificationPreferences/{uid} {
      allow read: if canManageUser(uid);
      allow create, update: if isOwner(uid)
        || (
          // SECURITY (P3-Step 2): membership-based.
          isSignedIn()
          && hasUser(uid)
          && targetUserOrgId(uid) is string
          && isOrgAdmin(targetUserOrgId(uid))
        );
      allow delete: if isOwner(uid) || isSuperAdmin();
    }

    // Admin-only collection for in-app pings, etc.
    match /adminNotifications/{id} {
      allow read: if isSuperAdmin()
        || (
          // SECURITY (P3-Step 2): require active org_admin membership in the
          // target organization — not just any platform admin role.
          resource.data.organizationId is string
          && resource.data.organizationId.size() > 0
          && isOrgAdmin(resource.data.organizationId)
        );
      // Allow super_admin or matching org_admin to flip read/readBy ONLY.
      allow update: if (
          isSuperAdmin()
          || (
            resource.data.organizationId is string
            && resource.data.organizationId.size() > 0
            && isOrgAdmin(resource.data.organizationId)
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readBy']);
      allow create, delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────
    // Security Events  (Admin Security Center — Lot 1/2/3/4)
    // ──────────────────────────────────────────────────────────────────
    match /securityEvents/{eventId} {
      // CREATE: only Cloud Functions / service account (admin SDK bypasses
      // these rules). The frontend uses the `logSecurityEvent` callable.
      allow create: if false;

      // READ: super_admin sees everything; org_admin sees only events that
      // touch their organization (matches resource.data.orgId OR
      // resource.data.attemptedOrgId).
      allow read: if isSuperAdmin()
        || (
          resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && isOrgAdmin(resource.data.orgId)
        )
        || (
          resource.data.attemptedOrgId is string
          && resource.data.attemptedOrgId.size() > 0
          && isOrgAdmin(resource.data.attemptedOrgId)
        );

      // UPDATE: only the resolution fields, by super_admin or matching
      // org_admin. Everything else is immutable from the client.
      allow update: if (
          isSuperAdmin()
          || (
            resource.data.orgId is string
            && resource.data.orgId.size() > 0
            && isOrgAdmin(resource.data.orgId)
          )
          || (
            resource.data.attemptedOrgId is string
            && resource.data.attemptedOrgId.size() > 0
            && isOrgAdmin(resource.data.attemptedOrgId)
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['resolved', 'resolvedBy', 'resolvedAt', 'resolutionNote'])
        && request.resource.data.resolved == true
        && request.resource.data.resolvedBy == request.auth.uid;

      // DELETE: never allowed from the client (audit trail must persist).
      allow delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────
    // Share Events  (lightweight viral-loop analytics for share buttons)
    // ──────────────────────────────────────────────────────────────────
    match /shareEvents/{eventId} {
      // CREATE: anyone (auth or anonymous public visitor) may log a share.
      // Strict shape validation prevents abuse / payload pollution.
      allow create: if
        request.resource.data.keys().hasOnly([
          'app','platform','sourcePage','sharedUrl','deviceType',
          'courseId','courseSlug','programId','programSlug',
          'orgId','userId','userRole','createdAt'
        ])
        && request.resource.data.app in ['innovacare_review','sygepec']
        && request.resource.data.platform in [
            'whatsapp','telegram','facebook','x','linkedin','email','copy','native_share'
           ]
        && request.resource.data.sourcePage in [
            'programs_page','program_detail','course_detail','catalogue_page'
           ]
        && request.resource.data.sharedUrl is string
        && request.resource.data.sharedUrl.size() > 0
        && request.resource.data.sharedUrl.size() <= 500
        && request.resource.data.createdAt == request.time
        && (
            !('userId' in request.resource.data)
            || request.resource.data.userId == null
            || (request.auth != null && request.resource.data.userId == request.auth.uid)
           );

      // READ: super_admin all; org_admin only events from their orgs.
      allow read: if isSuperAdmin()
        || (
          resource.data.orgId is string
          && resource.data.orgId.size() > 0
          && isOrgAdmin(resource.data.orgId)
        );

      // Immutable from clients.
      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────────────────────────
    // Nursing School Courses  (public catalog, admin-managed content)
    // ──────────────────────────────────────────────────────────────────
    match /nursing_school_courses/{courseId} {
      // Anyone can browse the catalog (isActive checked client-side via query)
      allow read: if true;
      // Only platform admins may add / edit / delete courses
      allow write: if isSuperAdmin() || isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────
    // Demo Requests  (institution leads from the For Educators page)
    // ──────────────────────────────────────────────────────────────────
    match /demo_requests/{requestId} {
      // Admins can read all requests (CRM / sales pipeline view)
      allow read: if isSuperAdmin() || isAdmin();
      // Any visitor (even unauthenticated) may submit a request
      allow create: if
        request.resource.data.keys().hasAll(['institutionName', 'contactName', 'email', 'studentCount', 'programType'])
        && request.resource.data.institutionName is string && request.resource.data.institutionName.size() > 0
        && request.resource.data.institutionName.size() <= 200
        && request.resource.data.contactName is string && request.resource.data.contactName.size() > 0
        && request.resource.data.contactName.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320
           && request.resource.data.studentCount is string
           && request.resource.data.studentCount.size() > 0
           && request.resource.data.studentCount.size() <= 50
        && request.resource.data.programType is string
           && request.resource.data.programType.size() > 0
           && request.resource.data.programType.size() <= 50
           && (!('phone' in request.resource.data) || request.resource.data.phone is string)
           && (!('message' in request.resource.data) || request.resource.data.message is string)
           && request.resource.data.status == 'pending'
        // Prevent mass-field injection — only allow known keys
        && request.resource.data.keys().hasOnly([
             'institutionName','contactName','email','phone',
             'studentCount','programType','message','status','createdAt'
           ]);
      // Authenticated owner (matched by email) can read their own submission
      allow read: if isSignedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email;
      // Only admins may update (e.g. change status to 'contacted' / 'closed')
      allow update: if isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────
    // Public Register Intake  (enriched self-registration profile)
    // ──────────────────────────────────────────────────────────────────
    match /register/{registrationId} {
      allow read: if isSuperAdmin() || isAdmin()
        || (isSignedIn() && request.auth.uid == registrationId);

      allow create: if isSignedIn()
        && request.auth.uid == registrationId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
             'uid','fullName','email','phone','country','learnerType','examGoal','status','source'
           ])
        && request.resource.data.keys().hasOnly([
             'uid','fullName','email','phone','country','learnerType','examGoal',
             'organizationName','referralSource','goals','status','source','role','orgId',
             'profileComplete','createdAt','updatedAt'
           ]);

      allow update: if (isSuperAdmin() || isAdmin())
        || (
          isSignedIn()
          && request.auth.uid == registrationId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == resource.data.status
          && request.resource.data.source == resource.data.source
        );

      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────
    // Tutors  (public profile directory)
    // ──────────────────────────────────────────────────────────────────
    match /tutors/{tutorId} {
      // Public read — active tutors are visible to everyone
      allow read: if true;
      // Only admins may manage tutor profiles
      allow write: if isSuperAdmin() || isAdmin();

      // Availability sub-collection (time slots per date)
      match /availability/{slotId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isAdmin();
      }
    }

    // ──────────────────────────────────────────────────────────────────
    // Tutor Bookings  (session requests from students)
    // ──────────────────────────────────────────────────────────────────
    match /tutor_bookings/{bookingId} {
      allow read: if isSuperAdmin()
        || isAdmin()
        || (isSignedIn() && resource.data.studentId == request.auth.uid)
        || (isSignedIn() && resource.data.tutorOwnerUid == request.auth.uid);
      // Tutor session creation and state transitions are server-managed through Cloud Functions.
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ██  LAB ENGINE  — Innovacare Interactive Lab Engine
    //     C-1 FIX: Merged from firestore.rules.lab-engine.rules
    //     Helpers reused from main file: isSignedIn(), isAdmin(), isOwner()
    // ══════════════════════════════════════════════════════════════════════════

    // ── Lab-engine role helpers ────────────────────────────────────────────────
    //
    // ROLE MODEL ALIGNMENT NOTE (P3-Step 2 migration):
    //
    // The platform uses two authoritative role sources:
    //   1. users/{uid}.role — legacy global identity field.
    //      Currently reliable only for: 'super_admin', 'guest', 'learner'.
    //      NOT authoritative for instructor/tutor/staff in multi-tenant context.
    //   2. userOrgMemberships/{uid}__{orgId}.role — membership-based, authoritative
    //      for all org-scoped admin/instructor/tutor/staff roles.
    //
    // For lab engine access:
    //   - "Admin" = can write lab definitions, seed files (super_admin/admin/manager
    //     from users.role, OR org_admin from any active membership).
    //   - "Instructor" = can read solution files, review sessions, grade submissions
    //     (instructor/tutor/staff from users.role, OR instructor from any active
    //     membership in any org — labs are platform-wide, not org-scoped).
    //
    // The helper below checks BOTH sources to ensure instructors whose role only
    // appears in userOrgMemberships (not in the legacy users.role field) are covered.

    // Check if the user has an active membership with an instructor-grade role
    // in ANY organization. Labs are platform-wide, so org is not filtered.
    // NOTE: Firestore Security Rules do not support collection group queries;
    // we check the legacy users.role as the primary gate, and rely on the
    // membership check only when a specific orgId is available in context.
    // For platform-wide lab access, users.role is the practical gate.

    function isLabAdminRole() {
      return isSignedIn() && (
        isAdmin()  // covers super_admin + /admins/{uid} allow-list
        || userRole(request.auth.uid) in ['admin', 'manager']
      );
    }

    function isLabInstructorOrAdmin() {
      return isSignedIn() && (
        // Global roles from users/{uid}.role (super_admin, admin, manager,
        // instructor, tutor, staff — these are set explicitly by super_admin
        // for platform-level instructors who are not tenant-specific).
        userRole(request.auth.uid) in ['super_admin', 'admin', 'manager', 'instructor', 'tutor', 'staff']
        // /admins/{uid} allow-list (belt-and-suspenders for super_admin proxies)
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        )
      );
    }

    // ── Lab Definitions (platform-managed, read-only for learners) ────────────
    // Learners can only see PUBLISHED labs.
    // Admins/instructors can read ALL statuses (including DRAFT).
    // Only admins can write — learners CANNOT write labDefinitions.

    match /labDefinitions/{labId} {
      allow read: if isSignedIn() && (
        resource.data.status == 'PUBLISHED' || isLabInstructorOrAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /labDefinitions/{labId}/tasks/{taskId} {
      // Only PUBLISHED lab tasks readable by learners; admins see all
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/labDefinitions/$(labId)).data.status == 'PUBLISHED'
        || isLabInstructorOrAdmin()
      );
      allow write: if isAdmin();
    }

    match /labDefinitions/{labId}/fileDefs/{fileDefId} {
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/labDefinitions/$(labId)).data.status == 'PUBLISHED'
        || isLabInstructorOrAdmin()
      );
      allow write: if isAdmin();
    }

    // ── Lab Sessions (learner-owned) ───────────────────────────────────────────
    // Learners read/write ONLY their own session.
    // Immutable userId and labId prevent session hijacking.
    // Instructors/admins can read all for review.

    match /labSessions/{sessionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isLabInstructorOrAdmin()
      );

      // Learner creates session for themselves only; initial statuses only
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['NOT_STARTED', 'IN_PROGRESS'];

      // Learner updates own session but CANNOT change userId or labId
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.labId  == resource.data.labId;

      allow delete: if isAdmin();

      // ── Workspace file metadata (sub-collection) ──────────────────────────
      // Metadata only — actual file content lives in Firebase Storage.
      // contentPreview is capped at 500 chars to enforce small doc size.

      match /workspaceFiles/{fileId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/labSessions/$(sessionId)).data.userId == request.auth.uid
          || isLabInstructorOrAdmin()
        );

        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/labSessions/$(sessionId)).data.userId == request.auth.uid
          && (!('contentPreview' in request.resource.data)
              || request.resource.data.contentPreview.size() <= 500);

        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/labSessions/$(sessionId)).data.userId == request.auth.uid
          && (!('contentPreview' in request.resource.data)
              || request.resource.data.contentPreview.size() <= 500);

        allow delete: if isAdmin();
      }

      // ── Validation Runs (sub-collection) ──────────────────────────────────
      // Learner creates; instructor/admin can read all.

      match /validationRuns/{runId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/labSessions/$(sessionId)).data.userId == request.auth.uid
          || isLabInstructorOrAdmin()
        );
        // Only the session owner may create a validation run
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/labSessions/$(sessionId)).data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Lab Submissions (learner creates, instructor reviews) ─────────────────
    // Learner can read own submission. Instructors/admins read all.
    // Only instructor/admin can update (review feedback).

    match /labSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isLabInstructorOrAdmin()
      );

      // Learner submits their own; must start PENDING and match their uid
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.instructorReviewStatus == 'PENDING';

      // Instructors may update review status/feedback only;
      // userId, labId, sessionId are immutable after creation
      allow update: if isLabInstructorOrAdmin()
        && request.resource.data.userId    == resource.data.userId
        && request.resource.data.labId     == resource.data.labId
        && request.resource.data.sessionId == resource.data.sessionId;

      allow delete: if isAdmin();
    }

    // ── AI Coach Interaction Log (rate-limiting audit trail) ──────────────────
    // Only learner can create their own log; instructors/admins can read all.

    match /labCoachLogs/{logId} {
      allow read: if isLabInstructorOrAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // END LAB ENGINE
    // ══════════════════════════════════════════════════════════════════════════

  }
}
