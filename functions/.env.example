# ─────────────────────────────────────────────────────────────
# Firebase Functions — Environment Variables Template
# Copy this file to .env (gitignored) and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Stripe — server-side secrets ONLY (never expose in Angular)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# Application base URL (used in Stripe Connect return/refresh URLs)
APP_BASE_URL=https://www.innovacarereview.com

# Stripe Connect onboarding return path (relative, appended to APP_BASE_URL)
# Default: /program-admin/africa-mode
STRIPE_CONNECT_ONBOARDING_PATH=/program-admin/africa-mode

# ─── Optional email ──────────────────────────────────────────
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.REPLACE_ME
# RESEND_API_KEY=re_REPLACE_ME

# ─── Optional Mobile Money ───────────────────────────────────
# MOBILE_MONEY_GATEWAY=campay
# MOBILE_MONEY_API_BASE_URL=https://demo.campay.net/api
# MOBILE_MONEY_API_KEY=REPLACE_ME
# MOBILE_MONEY_API_SECRET=REPLACE_ME
# MOBILE_MONEY_WEBHOOK_SECRET=REPLACE_ME

# ─── NOTES ───────────────────────────────────────────────────
# Firebase Functions v2 secrets are managed via:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# This .env.example is for local development reference only.
