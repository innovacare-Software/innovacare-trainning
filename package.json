{
  "name": "myapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "lint": "npm --prefix functions run lint && npm --prefix innovacare-training run lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && npm --prefix functions run typecheck && npm --prefix innovacare-training run typecheck",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/prerender-marketing-seo-locales.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:rules:smoke": "firebase emulators:exec --config firebase.rules-test.json --only firestore \"node scripts/firestore-rules-smoke.mjs\"",
    "security:audit": "npm audit --audit-level=high && npm --prefix functions run security:audit && npm --prefix innovacare-training run security:audit",
    "deploy:staging": "firebase deploy --project ${FIREBASE_PROJECT_ID_STAGING:?FIREBASE_PROJECT_ID_STAGING is required} --only hosting,functions",
    "deploy:production": "firebase deploy --project ${FIREBASE_PROJECT_ID_PRODUCTION:?FIREBASE_PROJECT_ID_PRODUCTION is required} --only hosting,functions"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.23",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.23",
    "@angular/compiler": "20.3.23",
    "@angular/core": "20.3.23",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "20.3.23",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.23",
    "@angular/platform-browser-dynamic": "20.3.23",
    "@angular/router": "20.3.23",
    "@angular/service-worker": "20.3.23",
    "@jsverse/transloco": "^8.3.0",
    "@popperjs/core": "2.11.8",
    "bootstrap": "^5.3.3",
    "cors": "^2.8.6",
    "echarts": "^6.0.0",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.6.82",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.26",
    "@angular/cli": "20.3.26",
    "@angular/compiler-cli": "20.3.23",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/html2canvas": "^0.5.35",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.9.11",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "flatted": "3.4.2",
    "lodash": "4.18.1"
  }
}
