{
  "name": "myapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:org-courses": "ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.org-course-tests.json --include=src/app/core/organization/services/organization-course-assignments.spec.ts --include=src/app/features/org-admin/pages/courses/org-admin-course-context.spec.ts",
    "typecheck": "tsc --noEmit",
    "test:rules:smoke": "firebase emulators:exec --config firebase.rules-test.json --only firestore \"node scripts/firestore-rules-smoke.mjs\"",
    "seed:communication:mocks": "firebase emulators:exec --config firebase.communication-test.json --only firestore \"node scripts/seed-communication-center-mocks.mjs\"",
    "test:communication:smoke": "firebase emulators:exec --config firebase.communication-test.json --only firestore \"node scripts/communication-center-rules-smoke.mjs\"",
    "test:communication:persistence": "firebase emulators:exec --config firebase.communication-test.json --only firestore \"node scripts/communication-center-persistence-smoke.mjs\"",
    "cap:sync": "ng build --configuration production && cap sync",
    "cap:open:android": "npm run cap:sync && cap open android",
    "cap:open:ios": "npm run cap:sync && cap open ios",
    "cap:run:android": "npm run cap:sync && cap run android",
    "cap:run:ios": "npm run cap:sync && cap run ios"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.2",
    "@angular/cdk": "^20.2.5",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.5",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "20.3.2",
    "@capacitor/android": "8.4.1",
    "@capacitor/cli": "8.4.1",
    "@capacitor/core": "8.4.1",
    "@capacitor/ios": "8.4.1",
    "@jsverse/transloco": "^8.3.0",
    "cors": "^2.8.6",
    "echarts": "^6.0.0",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.2",
    "@angular/cli": "^20.3.2",
    "@angular/compiler-cli": "^20.3.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/html2canvas": "^0.5.35",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.9.11",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
