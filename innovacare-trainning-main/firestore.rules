rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function signedIn() {
      return isSignedIn();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole(request.auth.uid) == "super_admin";
    }

    function requesterOrgId() {
      return isSignedIn() && hasUser(request.auth.uid)
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : null;
    }

    function sameRequesterOrg(orgId) {
      return isSignedIn() && requesterOrgId() != null && requesterOrgId() == orgId;
    }

    function sameOrg(orgId) {
      return sameRequesterOrg(orgId);
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && hasUser(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId)
        && (
          userRole(request.auth.uid) in ["admin", "manager", "org_admin", "org_manager"]
        );
    }

    function isOrgManager(orgId) {
      return isOrgMember(orgId) && userRole(request.auth.uid) in ["manager", "org_manager"];
    }

    function isOrgLearner(orgId) {
      return isOrgMember(orgId) && userRole(request.auth.uid) in ["learner", "guest", "org_learner"];
    }

    function hasActiveOrgMembership(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userOrgMemberships/$(request.auth.uid + '__' + orgId))
        && get(/databases/$(database)/documents/userOrgMemberships/$(request.auth.uid + '__' + orgId)).data.status == 'active';
    }

    function orgMembershipRole(orgId) {
      return hasActiveOrgMembership(orgId)
        ? get(/databases/$(database)/documents/userOrgMemberships/$(request.auth.uid + '__' + orgId)).data.role
        : '';
    }

    function canReadCommunicationOrg(orgId) {
      return isSuperAdmin() || (
        orgId is string
        && orgId.size() > 0
        && (
          isOrgAdmin(orgId)
          || orgMembershipRole(orgId) in ['org_admin', 'org_manager', 'program_admin']
        )
      );
    }

    function canWriteCommunicationOrg(orgId) {
      return isSuperAdmin() || (
        orgId is string
        && orgId.size() > 0
        && (
          isOrgAdmin(orgId)
          || orgMembershipRole(orgId) in ['org_admin', 'org_manager', 'program_admin']
        )
      );
    }

    function validCommunicationSafety(data) {
      return data.keys().hasAll(['safety'])
        && data.safety is map
        && data.safety.mode == 'draft_only'
        && data.safety.mockOnly == true
        && data.safety.provider == 'none'
        && data.safety.canAutoSend == false;
    }

    function validCommunicationDraftWrite() {
      return request.resource.data.orgId is string
        && request.resource.data.orgId.size() > 0
        && validCommunicationSafety(request.resource.data);
    }

    function validCommunicationDraftResource() {
      return resource.data.orgId is string
        && resource.data.orgId.size() > 0
        && validCommunicationSafety(resource.data);
    }

    function isCommunicationDraftStatus(status) {
      return status == 'draft'
        || status == 'approval_pending'
        || status == 'approved'
        || status == 'archived';
    }

    function isApprovalPriority(priority) {
      return priority == 'low'
        || priority == 'normal'
        || priority == 'high'
        || priority == 'critical';
    }

    function validTemplateDraftWrite() {
      return request.resource.data.status is string
        && isCommunicationDraftStatus(request.resource.data.status);
    }

    function validSegmentDraftWrite() {
      return request.resource.data.status is string
        && isCommunicationDraftStatus(request.resource.data.status);
    }

    function validNewsletterDraftWrite() {
      return request.resource.data.status is string
        && isCommunicationDraftStatus(request.resource.data.status);
    }

    function validCampaignDraftWrite() {
      return request.resource.data.status is string
        && (
          request.resource.data.status == 'draft'
          || request.resource.data.status == 'approval_pending'
          || request.resource.data.status == 'approved'
          || (
            request.resource.data.status == 'scheduled'
            && request.resource.data.scheduledAt is string
            && resource != null
            && resource.data.status == 'approved'
          )
        );
    }

    function validApprovalDraftWrite() {
      return request.resource.data.status is string
        && (
          request.resource.data.status == 'pending'
          || request.resource.data.status == 'approved'
          || request.resource.data.status == 'rejected'
        )
        && request.resource.data.priority is string
        && isApprovalPriority(request.resource.data.priority);
    }

    function validAuditDraftWrite() {
      return request.resource.data.actionType is string
        && (
          request.resource.data.actionType == 'draft_created'
          || request.resource.data.actionType == 'draft_updated'
          || request.resource.data.actionType == 'approval_requested'
          || request.resource.data.actionType == 'approval_decision'
          || request.resource.data.actionType == 'preview_generated'
        );
    }

    // Read role from users/{uid}
    function userRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : "";
    }

    // Admin capability used by client features (includes manager + super_admin).
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
        ||
        (userRole(request.auth.uid) in ["super_admin", "admin", "manager", "org_admin", "org_manager"])
      );
    }

    function canManageUser(uid) {
      return isSuperAdmin()
        || isOwner(uid)
        || (
          isSignedIn()
          && hasUser(request.auth.uid)
          && hasUser(uid)
          && userRole(request.auth.uid) in ["admin", "manager", "org_admin", "org_manager"]
          && get(/databases/$(database)/documents/users/$(uid)).data.orgId == requesterOrgId()
        );
    }

    function canAssignLearner(uid) {
      return isSignedIn()
        && hasUser(request.auth.uid)
        && hasUser(uid)
        && userRole(request.auth.uid) in ["admin", "manager", "org_admin", "org_manager"]
        && get(/databases/$(database)/documents/users/$(uid)).data.orgId == requesterOrgId()
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ["learner", "org_learner"];
    }

    function hasOrgUser(orgId, uid) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(uid));
    }

    function hasOrgCourse(orgId, courseId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/courses/$(courseId));
    }

    function isProgramsAdmin() {
      return isSignedIn()
        && hasUser(request.auth.uid)
        && (
          userRole(request.auth.uid) == "super_admin"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProgramAdmin == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProgramStaff == true
        );
    }

    function isProgramAdmin() {
      return isSignedIn()
        && hasUser(request.auth.uid)
        && (
          userRole(request.auth.uid) == "super_admin"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProgramAdmin == true
        );
    }

    function isProgramStaff() {
      return isSignedIn()
        && hasUser(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProgramStaff == true;
    }

    function canManagePrograms() {
      return isProgramAdmin() || isProgramStaff();
    }

    function isProgramLearner() {
      return isSignedIn()
        && hasUser(request.auth.uid)
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProgramLearner == true
          || userRole(request.auth.uid) in ["guest", "learner"]
        );
    }

    function isClinician() {
      return isSignedIn() && (
        userRole(request.auth.uid) == "nurse"
        || userRole(request.auth.uid) == "lpn"
        || userRole(request.auth.uid) == "np"
        || userRole(request.auth.uid) == "caregiver"
      );
    }

    // Is current user the assignee of a given task object?
    function isAssignedTo(task) {
      return isSignedIn() && task.assignedTo == request.auth.uid;
    }

    // Allow only forward, safe status moves for clinicians
    // new -> assigned -> in_progress -> done|cancelled
    function statusTransitionOk(old, neu) {
      return
        (old == "new"         && neu in ["new","assigned"]) ||
        (old == "assigned"    && neu in ["assigned","in_progress","cancelled"]) ||
        (old == "in_progress" && neu in ["in_progress","done","cancelled"]) ||
        (old == "done"        && neu == "done") ||
        (old == "cancelled"   && neu == "cancelled");
    }

    function validPublicOfferPayload() {
      return request.resource.data.keys().hasOnly([
        'type','orgId','courseId','title','description','imageUrl',
        'price','currency','stripePriceId','isActive','isPublic',
        'createdAt','updatedAt','publishedBy'
      ])
      && request.resource.data.type == 'course'
      && request.resource.data.orgId is string
      && request.resource.data.orgId.size() > 0
      && request.resource.data.courseId is string
      && request.resource.data.courseId.size() > 0
      && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && (!('description' in request.resource.data) || request.resource.data.description is string)
      && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
      && request.resource.data.price is number
      && request.resource.data.price > 0
      && request.resource.data.currency is string
      && request.resource.data.currency.size() >= 3
      && request.resource.data.currency.size() <= 8
      && request.resource.data.stripePriceId is string
      && request.resource.data.stripePriceId.size() > 0
      && request.resource.data.isActive is bool
      && request.resource.data.isPublic is bool;
    }

    // ---------- Small utils ----------
    function hasOnlyKeys(m, keys) {
      return m.keys().hasOnly(keys);
    }

    function isString(x) {
      return x is string;
    }

    function isBool(x) {
      return x is bool;
    }

    function isNumber(x) {
      return x is number;
    }

    // ---------- Validators from merged rules ----------
    function validCourse(d) {
      return hasOnlyKeys(d, [
        'title','subtitle','description','lang','durationMin','ceCredit',
        'active','tags','imageUrl','createdAt','updatedAt','kind','sections','url','code',
        'type','level','lecturer','disclosures','targetAudience','prerequisites',
        'requirements','accomodations','passingScore','lockedSequence','isPublic',
        'orgId','orgType','healthMeta','releaseAt','publishedAt','exipirationDate',
        'confirmAt','confirmBy','confirmMessage'
      ])
      && isString(d.title)
      && isString(d.description)
      && isString(d.lang)
      && isNumber(d.durationMin)
      && isBool(d.active)
      && isString(d.kind)
      && (!('subtitle' in d) || isString(d.subtitle))
      && (!('ceCredit' in d) || isNumber(d.ceCredit))
      && (!('tags' in d) || d.tags is list)
      && (!('imageUrl' in d) || isString(d.imageUrl))
      && (!('sections' in d) || d.sections is list)
      && (!('url' in d) || isString(d.url))
      && (!('code' in d) || isString(d.code))
      && (!('type' in d) || isString(d.type))
      && (!('level' in d) || isString(d.level))
      && (!('lecturer' in d) || isString(d.lecturer))
      && (!('disclosures' in d) || d.disclosures is list)
      && (!('targetAudience' in d) || d.targetAudience is list)
      && (!('prerequisites' in d) || d.prerequisites is list)
      && (!('requirements' in d) || d.requirements is list)
      && (!('accomodations' in d) || isString(d.accomodations))
      && (!('passingScore' in d) || isNumber(d.passingScore))
      && (!('lockedSequence' in d) || isBool(d.lockedSequence))
      && (!('isPublic' in d) || isBool(d.isPublic))
      && (!('orgId' in d) || d.orgId == null || isString(d.orgId))
      && (!('orgType' in d) || isString(d.orgType))
      && (!('healthMeta' in d) || d.healthMeta is map)
      && (!('releaseAt' in d) || d.releaseAt is timestamp)
      && (!('publishedAt' in d) || d.publishedAt is timestamp)
      && (!('exipirationDate' in d) || d.exipirationDate is timestamp)
      && (!('confirmAt' in d) || d.confirmAt is timestamp)
      && (!('confirmBy' in d) || isString(d.confirmBy))
      && (!('confirmMessage' in d) || isString(d.confirmMessage));
    }

    function validCert(d) {
      return hasOnlyKeys(d, ['code','name','credit'])
        && isString(d.code)
        && isString(d.name)
        && isString(d.credit);
    }

    function validExam(d) {
      return hasOnlyKeys(d, ['title','questions','available','url','createdAt','updatedAt','passPct'])
        && isString(d.title)
        && isNumber(d.questions)
        && d.questions >= 1
        && isBool(d.available)
        && (!('url' in d) || isString(d.url));
    }

    function validWound(d) {
      return hasOnlyKeys(d, [
        'id','name','aliases','category','stage','definition','pathophysiology',
        'clinical_features','common_sites','risk_factors','assessment','interventions',
        'topical_treatments','expected_healing_time','documentation_example',
        'prevention','images','references','tags','createdAt','updatedAt','locale'
      ])
      && (d.id is string)
      && (d.name is string)
      && (d.definition is string);
    }

    // ---------- VALIDATORS FOR COMMON MODELS ----------
    function validPolicy(d) {
      return (d.title is string && d.title.size() > 0)
        && (d.content is string && d.content.size() > 0)
        && (d.version is string || d.version is number)
        && (d.createdAt is timestamp)
        && ((!('updatedAt' in d)) || d.updatedAt is timestamp);
    }

    function hasAdminClaim() {
      return isSignedIn() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.role == 'admin')
      );
    }

    function hasManagerClaim() {
      return isSignedIn() && (
        (request.auth.token.manager == true) ||
        (request.auth.token.role == 'manager')
      );
    }

    function isManager() {
      return isSignedIn() && (
        userRole(request.auth.uid) in ['manager', 'org_manager'] || hasManagerClaim()
      );
    }

    // ---------- Admin allow-list doc ----------
    match /admins/{uid} {
      allow read, write: if false; // managed server-side/console only
    }

    // ---------- USERS ----------
    match /users/{uid} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid)
        || (
          isSignedIn()
          && hasUser(request.auth.uid)
          && userRole(request.auth.uid) in ["admin", "manager", "org_admin", "org_manager"]
          && resource.data.orgId is string
          && resource.data.orgId == requesterOrgId()
        );

      // super_admin full control
      // org admin/manager can manage users of their org only, without super_admin escalation
      // self-write cannot change role/orgId/active
      allow create: if isSuperAdmin()
        || (
          isSignedIn()
          && hasUser(request.auth.uid)
          && userRole(request.auth.uid) in ["admin", "manager", "org_admin", "org_manager"]
          && request.resource.data.orgId is string
          && request.resource.data.orgId == requesterOrgId()
          && request.resource.data.role in ["admin", "manager", "org_admin", "org_manager", "learner", "org_learner", "guest"]
        )
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "guest"
          && (!('orgId' in request.resource.data) || request.resource.data.orgId == null)
        );

      allow update: if isSuperAdmin()
        || (
          isSignedIn()
          && hasUser(request.auth.uid)
          && userRole(request.auth.uid) in ["admin", "manager", "org_admin", "org_manager"]
          && resource.data.orgId is string
          && resource.data.orgId == requesterOrgId()
          && request.resource.data.orgId == resource.data.orgId
          && request.resource.data.role in ["admin", "manager", "org_admin", "org_manager", "learner", "org_learner", "guest"]
        )
        || (
          isSignedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.orgId == resource.data.orgId
        );

      allow delete: if isSuperAdmin();
    }

    // ---------- ORGANIZATIONS (multi-tenant boundary) ----------
    match /organizations/{orgId} {
      // Needed for organization-code login lookup; only active orgs are visible publicly.
      allow read: if ((!('active' in resource.data)) || resource.data.active == true)
        || isSuperAdmin()
        || isOrgMember(orgId)
        || isOrgAdmin(orgId);

      allow create, update, delete: if isSuperAdmin();

      match /orgUsers/{uid} {
        allow read: if isSuperAdmin() || isOrgMember(orgId) || isOrgAdmin(orgId);
        allow create, update, delete: if false;
      }

      // ---------- STRICT ORG-SCOPED DOMAIN ----------
      match /users/{uid} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && request.auth.uid == uid);

        allow create, update: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow delete: if isSuperAdmin() || isOrgAdmin(orgId);
      }

      // Canonical path for courses assigned by platform to organization.
      match /assignedCourses/{courseId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        // Platform owner assigns courses to organizations.
        allow create, update, delete: if isSuperAdmin();
      }

      // Backward compatibility path.
      match /courses/{courseId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin();
      }

      match /courseAssignments/{assignmentId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);

        // Org admin/manager can assign only approved org courses to users of same org.
        allow create: if isSuperAdmin()
          || (
            (isOrgAdmin(orgId) || isOrgManager(orgId))
            && request.resource.data.orgId == orgId
            && request.resource.data.userId is string
            && hasOrgUser(orgId, request.resource.data.userId)
            && request.resource.data.courseId is string
            && (
              hasOrgCourse(orgId, request.resource.data.courseId)
              || exists(/databases/$(database)/documents/organizations/$(orgId)/assignedCourses/$(request.resource.data.courseId))
            )
          );

        allow update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /enrollments/{enrollmentId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /progress/{progressId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && request.resource.data.userId == request.auth.uid);

        allow delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /overdue/{recordId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /policies/{policyId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /policyAcknowledgments/{ackId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);

        allow create, update: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && request.resource.data.userId == request.auth.uid);

        allow delete: if isSuperAdmin() || isOrgAdmin(orgId);
      }

      match /woundLibrary/{itemId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /documents/{documentId} {
        allow read: if isSuperAdmin() || isOrgMember(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId);
      }

      match /reports/{reportId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /alerts/{alertId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.assignedTo == request.auth.uid);

        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /followUpActions/{actionId} {
        allow read: if isSuperAdmin()
          || isOrgAdmin(orgId)
          || isOrgManager(orgId)
          || (isOrgMember(orgId) && resource.data.assignedTo == request.auth.uid);

        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }

      match /auditLogs/{logId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow create: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow update, delete: if false;
      }

      match /troubleshootingIssues/{issueId} {
        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);
      }
    }

    // Legacy path compatibility: /org/{orgId}/orgUsers/{uid}
    match /org/{orgId}/orgUsers/{uid} {
      allow read: if isSuperAdmin() || isOrgMember(orgId) || isOrgAdmin(orgId);
      allow create, update, delete: if false;
    }

    match /organizationCourseAssignments/{assignmentId} {
      allow read: if isSuperAdmin()
        || (resource.data.orgId is string && isOrgMember(resource.data.orgId));

      allow create, update, delete: if isSuperAdmin();
    }

    match /adminLogs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ---------- USER COMMERCE DATA (owner-read, sensitive server-write) ----------
    match /users/{uid}/carts/{cartId} {
      allow read: if isAdmin()
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/orders/{orderId} {
      allow read: if isAdmin()
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/guestEnrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/guestPrograms/{programAccessId} {
      allow read: if isAdmin()
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/bookings/{bookingId} {
      allow read: if isAdmin()
        || (
          isSignedIn() && request.auth.uid == uid
          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))
        );
      allow create, update, delete: if false;
    }

    match /users/{uid}/notificationReads/{notificationId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin() || isOwner(uid);
    }

    match /users/{uid}/licenses/{licenseId} {
      allow read: if canManageUser(uid);
      allow create, update, delete: if canManageUser(uid);
    }

    match /users/{uid}/enrollments/{courseId} {
      allow read: if canManageUser(uid);
      allow create, update: if isSuperAdmin() || isOwner(uid) || canAssignLearner(uid);
      allow delete: if isSuperAdmin();
    }

    match /users/{uid}/launchTickets/{ticketId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin() || isOwner(uid);
    }

    match /users/{uid}/wallet/{walletId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin();
    }

    match /users/{uid}/rewards/{rewardId} {
      allow read: if canManageUser(uid);
      allow create, update: if canManageUser(uid);
      allow delete: if isSuperAdmin();
    }

    // ---------- SERVICES (public read; admin write) ----------
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(
            ['title','slug','active','blurb','bullets','category','image','duration','order']
           )
        && (request.resource.data.title is string)
        && (request.resource.data.slug is string)
        && (request.resource.data.active is bool);
    }

    // ---------- COURSES & OFFERS (public catalogue read) ----------
    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && validCourse(request.resource.data);
      allow delete: if isSuperAdmin();

      match /certifications/{id} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSuperAdmin() && validCert(request.resource.data);
      }

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      match /exams/{examId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSuperAdmin() && validExam(request.resource.data);

        match /questions/{questionId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isSuperAdmin();
        }

        match /answerKey/{questionId} {
          allow read, create, update, delete: if isSuperAdmin();
        }
      }
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // ---------- EVENTS & REGISTRATIONS ----------
    match /events/{eventId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Only admins can create/update/delete
      allow create, update, delete: if isAdmin();

      match /registrations/{uid} {
        // Admin or owner can read
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        // Owner can self-register
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == uid;
        // Admin or owner can delete
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        // No updates allowed
        allow update: if false;
      }
    }

    // ---------- TIMESHEETS & ENTRIES ----------
    match /timesheets/{tsId} {
      function belongsTo(uid) { return isSignedIn() && tsId.split('_')[0] == uid; }

      allow read: if isSignedIn() && (belongsTo(request.auth.uid) || isAdmin());
      allow create: if isSignedIn() && belongsTo(request.auth.uid);

      allow update: if isSignedIn() && (
        (belongsTo(request.auth.uid) &&
          !('approvedAt' in request.resource.data) &&
          !('approvedBy' in request.resource.data)) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['status','approvedAt','approvedBy','updatedAt','totalHours']))
      );
      allow delete: if isAdmin();

      match /entries/{entryId} {
        allow read: if isSignedIn() && (belongsTo(request.auth.uid) || isAdmin());
        allow create, update: if isSignedIn() && (
          (belongsTo(request.auth.uid) &&
            (get(/databases/$(database)/documents/timesheets/$(tsId)).data.status in ['open','submitted'])) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ---------- NOTIFICATIONS (consolidated) ----------
    match /notifications/{notificationId} {
      // Authenticated users can read notifications
      allow read: if request.auth != null;
      
      // Admin or manager can create/update notifications
      allow create, update: if isAdmin() || isManager();
      
      // Only admin can delete
      allow delete: if isAdmin();
    }

    match /demoRequests/{requestId} {
      allow create: if request.time < timestamp.date(2099,1,1)
        && request.resource.data.keys().hasOnly([
          'fullName',
          'workEmail',
          'phone',
          'organizationName',
          'organizationType',
          'selectedPlan',
          'message',
          'source',
          'status',
          'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.workEmail is string
        && request.resource.data.workEmail.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.organizationName is string
        && request.resource.data.organizationType is string
        && request.resource.data.selectedPlan is string
        && request.resource.data.message is string
        && request.resource.data.source is string
        && request.resource.data.status == 'new';

      allow read, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /billingRecords/{recordId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.uid is string
          && canManageUser(resource.data.uid)
        );

      allow create, update: if isSuperAdmin()
        || (
          isSignedIn()
          && request.resource.data.uid is string
          && canManageUser(request.resource.data.uid)
        );

      allow delete: if isSuperAdmin();
    }

    match /publicOffers/{offerId} {
      allow read: if (resource.data.isActive == true && resource.data.isPublic == true)
        || sameRequesterOrg(resource.data.orgId)
        || isAdmin();
      allow create: if isSuperAdmin() && validPublicOfferPayload();
      allow update: if isSuperAdmin()
        && validPublicOfferPayload()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSuperAdmin();
    }

    // ---------- WOUND LIBRARY ----------
    match /woundLibrary/{docId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Only admins can create/update/delete
      allow create, update: if isSuperAdmin() && validWound(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /wounds/{docId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Only admins can create/update/delete
      allow create, update: if isSuperAdmin() && validWound(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ---------- COURSE ASSIGNMENTS ----------
    match /courseAssignments/{docId} {
      // Authenticated users can read
      allow read: if request.auth != null;
      // Super admin can manage everything, org admin/manager can assign learners in same org only.
      allow create, update, delete: if isSuperAdmin()
        || (
          isSignedIn()
          && hasUser(request.auth.uid)
          && userRole(request.auth.uid) in ["admin", "manager"]
          && (
            (
              request.resource.data.userId is string
              && hasUser(request.resource.data.userId)
              && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.orgId == requesterOrgId()
              && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.role == "learner"
            )
            ||
            (
              resource.data.userId is string
              && hasUser(resource.data.userId)
              && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.orgId == requesterOrgId()
              && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.role == "learner"
            )
          )
        );
    }

    // ---------- PROGRAMS ----------
    match /programs/{programId} {
      allow read: if (
          resource.data.active == true
          && resource.data.status == "PUBLISHED"
        )
        || canManagePrograms();

      allow create, update, delete: if canManagePrograms();

      match /modules/{moduleId} {
        allow read: if (
            get(/databases/$(database)/documents/programs/$(programId)).data.active == true
            && get(/databases/$(database)/documents/programs/$(programId)).data.status == "PUBLISHED"
          )
          || canManagePrograms();
        allow create, update, delete: if canManagePrograms();
      }

      match /lessons/{lessonId} {
        allow read: if (
            get(/databases/$(database)/documents/programs/$(programId)).data.active == true
            && get(/databases/$(database)/documents/programs/$(programId)).data.status == "PUBLISHED"
          )
          || canManagePrograms();
        allow create, update, delete: if canManagePrograms();
      }

      match /simulations/{simulationId} {
        allow read: if isProgramLearner() || canManagePrograms();
        allow create, update, delete: if canManagePrograms();
      }

      match /caseStudies/{caseStudyId} {
        allow read: if isProgramLearner() || canManagePrograms();
        allow create, update, delete: if canManagePrograms();
      }

      match /assessments/{assessmentId} {
        allow read: if isProgramLearner() || canManagePrograms();
        allow create, update, delete: if canManagePrograms();
      }

      match /documents/{documentId} {
        allow read: if isProgramLearner() || canManagePrograms();
        allow create, update, delete: if canManagePrograms();
      }

      match /liveSessions/{sessionId} {
        allow read: if isProgramLearner() || canManagePrograms();
        allow create, update, delete: if canManagePrograms();
      }
    }

    match /programEnrollments/{enrollmentId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'programId',
          'userId',
          'programTitle',
          'category',
          'learnerName',
          'learnerEmail',
          'learnerPhone',
          'notes',
          'status',
          'amount',
          'currency',
          'paymentStatus',
          'reviewStatus',
          'enrolledAt',
          'activatedAt',
          'completedAt',
          'orgId',
          'createdAt',
          'updatedAt'
        ])
        && isOwner(request.resource.data.userId)
        && request.resource.data.programId is string
        && request.resource.data.programTitle is string
        && request.resource.data.learnerName is string
        && request.resource.data.learnerEmail is string
        && request.resource.data.learnerPhone is string
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.reviewStatus == 'pending_review';

      allow read: if canManagePrograms()
        || isOwner(resource.data.userId);

      allow update: if canManagePrograms()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.programId == resource.data.programId
        && request.resource.data.programTitle == resource.data.programTitle
        && request.resource.data.status in ['pending', 'approved', 'active', 'completed', 'cancelled', 'rejected']
        && request.resource.data.paymentStatus in ['unpaid', 'pending', 'paid', 'refunded']
        && request.resource.data.reviewStatus in ['pending_review', 'approved', 'denied'];

      allow delete: if canManagePrograms();
    }

    match /programSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /users/{uid}/programProgress/{programId} {
      allow read: if canManagePrograms() || isOwner(uid);
      allow create, update: if canManagePrograms() || isOwner(uid);
      allow delete: if canManagePrograms();
    }

    match /users/{uid}/moduleProgress/{moduleId} {
      allow read: if canManagePrograms() || isOwner(uid);
      allow create, update: if canManagePrograms() || isOwner(uid);
      allow delete: if canManagePrograms();
    }

    match /users/{uid}/simulationAttempts/{attemptId} {
      allow read: if canManagePrograms() || isOwner(uid);
      allow create, update: if canManagePrograms() || isOwner(uid);
      allow delete: if canManagePrograms();
    }

    match /users/{uid}/assessmentAttempts/{attemptId} {
      allow read: if canManagePrograms() || isOwner(uid);
      allow create, update: if canManagePrograms() || isOwner(uid);
      allow delete: if canManagePrograms();
    }

    match /users/{uid}/lessonProgress/{lessonId} {
      allow read: if canManagePrograms() || isOwner(uid);
      allow create, update: if canManagePrograms() || isOwner(uid);
      allow delete: if canManagePrograms();
    }

    match /users/{uid}/caseStudyAttempts/{attemptId} {
      allow read: if canManagePrograms() || isOwner(uid);
      allow create, update: if canManagePrograms() || isOwner(uid);
      allow delete: if canManagePrograms();
    }

    // ---------- POLICIES (read by all authenticated; write by admin/manager) ----------
    match /policies/{policyId} {
      // Authenticated users can read all policies
      allow read: if request.auth != null;
      // Only admins can create/update with validation
      allow create: if isSuperAdmin() && validPolicy(request.resource.data);
      allow update: if isSuperAdmin() && validPolicy(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Singular alias for compatibility (both /policies and /policy point to same business logic)
    match /policy/{policyId} {
      // Authenticated users can read all policies
      allow read: if request.auth != null;
      // Only admins can create/update with validation
      allow create: if isSuperAdmin() && validPolicy(request.resource.data);
      allow update: if isSuperAdmin() && validPolicy(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /policy_acknowledgements/{ackId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- PATHWAY REQUESTS ----------
    match /pathwayRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'courseId',
          'courseTitle',
          'source',
          'status',
          'requesterUid',
          'addedAt'
        ])
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() > 0
        && request.resource.data.courseTitle is string
        && request.resource.data.courseTitle.size() > 0
        && request.resource.data.source is string
        && request.resource.data.status == 'new'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.addedAt is timestamp;

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.requesterUid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // ---------- CONTACTS (public create; admin read/update) ----------
    match /contacts/{doc} {
      allow create: if request.auth == null
        && request.time < timestamp.date(2099,1,1)
        && request.resource.data.keys().hasOnly(
             ['name','email','phone','reason','message','createdAt','status','userAgent','page']
           )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

   // ---------- BOOKINGS (public create; admin read/update) ----------
match /bookings/{doc} {
  // Allow any visitor (signed-in or not) to create a booking
  allow create: if
      (request.auth == null || request.auth != null)
      && request.time < timestamp.date(2099,1,1)
      // If you enable App Check, uncomment next line:
      // && request.appcheck.token != null
      // Only allow the exact schema your client sends
      && request.resource.data.keys().hasOnly([
           'serviceSlug','serviceTitle',
           'patient','preference','contact',
           'status','createdAt','userAgent'
         ])
      // Validate nested shapes
      && request.resource.data.patient.keys().hasOnly([
           'firstName','lastName','dob','woundType','notes'
         ])
      && request.resource.data.preference.keys().hasOnly([
           'mode','preferredDate','preferredTime','address'
         ])
      && request.resource.data.contact.keys().hasOnly([
           'name','phone','email','refSource'
         ])
      // Initial status & createdAt must be "now"
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time;

  // Only admins can read/update bookings
  allow read, update: if isAdmin();

  // No deletes from clients
  allow delete: if false;
}



    // ---------- REFERRALS (public create; admin read/update) ----------
    match /patientReferal/{doc} {
      allow create: if request.auth == null
        && request.time < timestamp.date(2099,1,1)
        && request.resource.data.keys().hasOnly([
             'serviceSlug','serviceTitle',
             'refType','refName','refOrg','refRole','refEmail','refPhone',
             'patientName','patientDob','patientArea',
             'diagnosis','urgency','notes',
             'contactPref','consent',
             'createdAt','status','page','userAgent'
           ])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // ---------- TASKS & subcollections ----------
    // Task schema (canonical fields)
    // { createdAt, createdBy, source, patient, service, scheduledAt, status, assignedTo, notes, lastUpdatedAt }
    match /tasks/{taskId} {

      // Admin can read; clinician can read IF assigned
      allow read: if isAdmin() || (isClinician() && isAssignedTo(resource.data));

      // Admin creates tasks with strict schema
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'createdAt','createdBy','source','patient','service',
             'scheduledAt','status','assignedTo','notes','lastUpdatedAt'
           ])
        && (request.resource.data.status in ['new','assigned','in_progress','done','cancelled']);

      // Updates
      // - Admin: any update
      // - Clinician (assignee): can START (-> in_progress), progress, or mark DONE/CANCELLED.
      //   Immutable fields must stay identical.
      //   lastUpdatedAt must move forward.
      allow update: if isAdmin()
        || (
          isClinician()
          && isAssignedTo(resource.data)

          // Immutable fields unchanged by clinician
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.source     == resource.data.source
          && request.resource.data.patient    == resource.data.patient
          && request.resource.data['service'] == resource.data['service']
          && request.resource.data.createdBy  == resource.data.createdBy
          && request.resource.data.createdAt  == resource.data.createdAt

          // Only these fields may exist in clinician updates
          && request.resource.data.keys().hasOnly([
               'createdAt','createdBy','source','patient','service',
               'scheduledAt','status','assignedTo','notes','lastUpdatedAt'
             ])

          // Allowed status values + only forward transitions
          && (request.resource.data.status in ['assigned','in_progress','done','cancelled'])
          && statusTransitionOk(resource.data.status, request.resource.data.status)

          // Force a forward-moving timestamp on update
          && (request.resource.data.lastUpdatedAt > resource.data.lastUpdatedAt)
        );

      allow delete: if isAdmin();

      // ---- NOTES subcollection ----
      // Schema: { createdAt, authorUid, text, followUpAt? }
      match /notes/{noteId} {
        // Admin OR assigned clinician can read notes
        allow read: if isAdmin()
          || (isClinician()
              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));

        // Create: admin or assigned clinician; author must be current user
        allow create: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text','followUpAt'])
            && request.resource.data.authorUid == request.auth.uid
          );

        // Update: admin or original author clinician; createdAt/authorUid immutable
        allow update: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && (request.auth.uid == resource.data.authorUid)
            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text','followUpAt'])
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.createdAt == resource.data.createdAt
          );

        // Delete: admin or original author clinician
        allow delete: if isAdmin()
          || (
            isClinician()
            && (request.auth.uid == resource.data.authorUid)
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
          );
      }

      // ---- VISITS (optional) ----
      match /visits/{visitId} {
        allow read: if isAdmin()
          || (isClinician()
              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));

        allow create: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && request.resource.data.keys().hasOnly(
                 ['createdAt','nurseUid','start','end','notes','outcome','vitals']
               )
            && request.resource.data.nurseUid == request.auth.uid
          );

        allow update: if isAdmin()
          || (isClinician() && resource.data.nurseUid == request.auth.uid);

        allow delete: if isAdmin();
      }

      // ---- MESSAGES (optional) ----
      match /messages/{msgId} {
        allow read: if isAdmin()
          || (isClinician()
              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));
        allow create: if isAdmin()
          || (
            isClinician()
            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)
            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text'])
            && request.resource.data.authorUid == request.auth.uid
          );
        allow update, delete: if isAdmin()
          || (isSignedIn() && request.auth.uid == resource.data.authorUid);
      }
    }

    // Admin-only collection for in-app pings, etc.
    match /communication_templates/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validTemplateDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validTemplateDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletters/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validNewsletterDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validNewsletterDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_campaigns/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validCampaignDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validCampaignDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_recipients/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_events/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /newsletter_analytics/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_segments/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validSegmentDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validSegmentDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_automations/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_approvals/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validApprovalDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validApprovalDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /communication_audits/{docId} {
      allow get: if validCommunicationDraftResource() && canReadCommunicationOrg(resource.data.orgId);
      allow list: if canReadCommunicationOrg(resource.data.orgId);
      allow create: if validCommunicationDraftWrite() && validAuditDraftWrite() && canWriteCommunicationOrg(request.resource.data.orgId);
      allow update, delete: if validCommunicationDraftResource()
        && validCommunicationDraftWrite()
        && validAuditDraftWrite()
        && request.resource.data.orgId == resource.data.orgId
        && canWriteCommunicationOrg(resource.data.orgId);
    }

    match /adminNotifications/{id} {
      allow read, write: if isAdmin();
    }
  }
}
