[debug] [2026-05-11T04:11:13.440Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/innovacare-stripe/rulesets {"name":"projects/innovacare-stripe/rulesets/6b11be6d-98ea-4ea0-8460-cca1cf43cb9c","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ---------- Helpers ----------\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(uid) {\r\n      return isSignedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    function hasUser(uid) {\r\n      return exists(/databases/$(database)/documents/users/$(uid));\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return isSignedIn() && userRole(request.auth.uid) == \"super_admin\";\r\n    }\r\n\r\n    function requesterOrgId() {\r\n      return isSignedIn() && hasUser(request.auth.uid)\r\n        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId\r\n        : null;\r\n    }\r\n\r\n    function sameRequesterOrg(orgId) {\r\n      return isSignedIn() && requesterOrgId() != null && requesterOrgId() == orgId;\r\n    }\r\n\r\n    function isOrgMember(orgId) {\r\n      // SECURITY (P3-Step 2): membership-based. Legacy users.orgId is no longer\r\n      // sufficient by itself — the user MUST have an active membership in orgId.\r\n      // super_admin is intentionally NOT counted as an org member here; callers\r\n      // combine `isSuperAdmin() || isOrgMember(orgId)` when they want both.\r\n      return membershipActive(orgId);\r\n    }\r\n\r\n    // --- Membership-based helpers (new multi-tenant model) ----------------\r\n    // A membership document lives at /userOrgMemberships/{uid}__{orgId}\r\n    // and authoritatively declares the role/status the user has within an org.\r\n    function membershipPath(orgId) {\r\n      return /databases/$(database)/documents/userOrgMemberships/$(request.auth.uid + \"__\" + orgId);\r\n    }\r\n\r\n    function hasMembership(orgId) {\r\n      return isSignedIn() && exists(membershipPath(orgId));\r\n    }\r\n\r\n    function membershipRole(orgId) {\r\n      return hasMembership(orgId) ? get(membershipPath(orgId)).data.role : \"\";\r\n    }\r\n\r\n    function membershipActive(orgId) {\r\n      return hasMembership(orgId) && get(membershipPath(orgId)).data.status == \"active\";\r\n    }\r\n\r\n    function hasActiveMembershipRole(orgId, roles) {\r\n      return membershipActive(orgId) && (membershipRole(orgId) in roles);\r\n    }\r\n\r\n    // Org admin / manager checks now require an explicit membership.\r\n    // Legacy users.role values for \"admin\"/\"manager\" are NOT honored anymore\r\n    // for org-scoped authorization — only super_admin keeps blanket powers.\r\n    function isOrgAdmin(orgId) {\r\n      return hasActiveMembershipRole(orgId, [\"org_admin\", \"program_admin\"]);\r\n    }\r\n\r\n    function isOrgManager(orgId) {\r\n      return hasActiveMembershipRole(orgId, [\"instructor\", \"org_admin\", \"program_admin\"]);\r\n    }\r\n\r\n    // Read role from users/{uid} (informational legacy field — DO NOT use\r\n    // for org-scoped authorization; use userOrgMemberships instead).\r\n    function userRole(uid) {\r\n      return exists(/databases/$(database)/documents/users/$(uid))\r\n        ? get(/databases/$(database)/documents/users/$(uid)).data.role\r\n        : \"\";\r\n    }\r\n\r\n    // Platform-wide admin capability.\r\n    // SECURITY (P3-Step 2): restricted to super_admin and the explicit\r\n    // /admins/{uid} allow-list. Legacy roles (admin/manager/org_admin/\r\n    // org_manager) NO LONGER grant blanket access — they must use the\r\n    // membership-based helpers (isOrgAdmin/isOrgManager/canManageProgramOrg).\r\n    function isAdmin() {\r\n      return isSignedIn() && (\r\n        userRole(request.auth.uid) == \"super_admin\"\r\n        || (\r\n          exists(/databases/$(database)/documents/admins/$(request.auth.uid))\r\n          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true\r\n        )\r\n      );\r\n    }\r\n\r\n    function targetUserOrgId(uid) {\r\n      return exists(/databases/$(database)/documents/users/$(uid))\r\n        ? get(/databases/$(database)/documents/users/$(uid)).data.orgId\r\n        : null;\r\n    }\r\n\r\n    function canManageUser(uid) {\r\n      // SECURITY (P3-Step 2): require an active org_admin/program_admin\r\n      // membership in the TARGET user's organization. Legacy users.role\r\n      // checks have been removed.\r\n      return isSuperAdmin()\r\n        || isOwner(uid)\r\n        || (\r\n          isSignedIn()\r\n          && hasUser(uid)\r\n          && targetUserOrgId(uid) is string\r\n          && isOrgAdmin(targetUserOrgId(uid))\r\n        );\r\n    }\r\n\r\n    function canAssignLearner(uid) {\r\n      // SECURITY (P3-Step 2): membership-based. Org admin or instructor in\r\n      // the target's org may assign provided the target is a learner.\r\n      return isSignedIn()\r\n        && hasUser(uid)\r\n        && targetUserOrgId(uid) is string\r\n        && (\r\n          isSuperAdmin()\r\n          || isOrgManager(targetUserOrgId(uid))\r\n        )\r\n        && get(/databases/$(database)/documents/users/$(uid)).data.role in [\"learner\", \"org_learner\"];\r\n    }\r\n\r\n    function hasOrgUser(orgId, uid) {\r\n      return exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(uid));\r\n    }\r\n\r\n    function hasOrgCourse(orgId, courseId) {\r\n      return exists(/databases/$(database)/documents/organizations/$(orgId)/courses/$(courseId));\r\n    }\r\n\r\n    // SECURITY (P3-Step 2): the legacy no-arg helpers `isProgramAdmin()`,\r\n    // `isProgramStaff()` and `canManagePrograms()` have been REMOVED. They\r\n    // granted authority based on global users.role flags which created\r\n    // cross-tenant admin escalation. All program-management authorization\r\n    // now goes through `canManageProgramOrg(orgId)` (membership-based).\r\n\r\n      function canManageProgramOrg(orgId) {\r\n        // SECURITY (P3-Step 2): membership-based. Requires either super_admin\r\n        // or an ACTIVE program_admin/org_admin membership in the target org.\r\n        // Legacy users.role + sameRequesterOrg() path has been removed.\r\n        return isSuperAdmin()\r\n          || (\r\n            orgId is string\r\n            && orgId.size() > 0\r\n            && hasActiveMembershipRole(orgId, [\"program_admin\", \"org_admin\"])\r\n          );\r\n      }\r\n\r\n      function programDocOrgId(programId) {\r\n        return exists(/databases/$(database)/documents/programs/$(programId))\r\n          ? get(/databases/$(database)/documents/programs/$(programId)).data.orgId\r\n          : null;\r\n      }\r\n\r\n      function canManageProgramById(programId) {\r\n        return programId is string\r\n          && programId.size() > 0\r\n          && canManageProgramOrg(programDocOrgId(programId));\r\n      }\r\n\r\n      function canReadManagedUserPrivateData(uid, orgId) {\r\n        // SECURITY (P3-Step 2): membership-based. The reader must be either\r\n        // super_admin, the owner, or hold an active org_admin/program_admin\r\n        // membership in the data's orgId (with fallback to the target user's\r\n        // stored orgId when the document carries no orgId).\r\n        return isSuperAdmin()\r\n          || (\r\n            isSignedIn()\r\n            && (\r\n              (orgId is string && orgId.size() > 0 && isOrgAdmin(orgId))\r\n              || (\r\n                hasUser(uid)\r\n                && targetUserOrgId(uid) is string\r\n                && isOrgAdmin(targetUserOrgId(uid))\r\n              )\r\n            )\r\n          );\r\n      }\r\n\r\n    function isProgramLearner() {\r\n      return isSignedIn()\r\n        && hasUser(request.auth.uid)\r\n        && (\r\n          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isProgramLearner == true\r\n          || userRole(request.auth.uid) in [\"guest\", \"learner\"]\r\n        );\r\n    }\r\n\r\n    function isClinician() {\r\n      return isSignedIn() && (\r\n        userRole(request.auth.uid) == \"nurse\"\r\n        || userRole(request.auth.uid) == \"lpn\"\r\n        || userRole(request.auth.uid) == \"np\"\r\n        || userRole(request.auth.uid) == \"caregiver\"\r\n      );\r\n    }\r\n\r\n    // Is current user the assignee of a given task object?\r\n    function isAssignedTo(task) {\r\n      return isSignedIn() && task.assignedTo == request.auth.uid;\r\n    }\r\n\r\n    // Allow only forward, safe status moves for clinicians\r\n    // new -> assigned -> in_progress -> done|cancelled\r\n    function statusTransitionOk(old, neu) {\r\n      return\r\n        (old == \"new\"         && neu in [\"new\",\"assigned\"]) ||\r\n        (old == \"assigned\"    && neu in [\"assigned\",\"in_progress\",\"cancelled\"]) ||\r\n        (old == \"in_progress\" && neu in [\"in_progress\",\"done\",\"cancelled\"]) ||\r\n        (old == \"done\"        && neu == \"done\") ||\r\n        (old == \"cancelled\"   && neu == \"cancelled\");\r\n    }\r\n\r\n    function validPublicOfferPayload() {\r\n      return request.resource.data.keys().hasOnly([\r\n        'type','orgId','courseId','title','description','imageUrl',\r\n        'price','currency','stripePriceId','isActive','isPublic',\r\n        'createdAt','updatedAt','publishedBy'\r\n      ])\r\n      && request.resource.data.type == 'course'\r\n      && request.resource.data.orgId is string\r\n      && request.resource.data.orgId.size() > 0\r\n      && request.resource.data.courseId is string\r\n      && request.resource.data.courseId.size() > 0\r\n      && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))\r\n      && request.resource.data.title is string\r\n      && request.resource.data.title.size() > 0\r\n      && (!('description' in request.resource.data) || request.resource.data.description is string)\r\n      && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)\r\n      && request.resource.data.price is number\r\n      && request.resource.data.price > 0\r\n      && request.resource.data.currency is string\r\n      && request.resource.data.currency.size() >= 3\r\n      && request.resource.data.currency.size() <= 8\r\n      && request.resource.data.stripePriceId is string\r\n      && request.resource.data.stripePriceId.size() > 0\r\n      && request.resource.data.isActive is bool\r\n      && request.resource.data.isPublic is bool;\r\n    }\r\n\r\n    // ---------- Small utils ----------\r\n    function hasOnlyKeys(m, keys) {\r\n      return m.keys().hasOnly(keys);\r\n    }\r\n\r\n    function isString(x) {\r\n      return x is string;\r\n    }\r\n\r\n    function isBool(x) {\r\n      return x is bool;\r\n    }\r\n\r\n    function isNumber(x) {\r\n      return x is number;\r\n    }\r\n\r\n    // ---------- Validators from merged rules ----------\r\n    function validCourse(d) {\r\n      return hasOnlyKeys(d, [\r\n        'title','subtitle','description','lang','durationMin','ceCredit',\r\n        'active','tags','imageUrl','createdAt','updatedAt','kind','sections','url','code',\r\n        'type','level','lecturer','disclosures','targetAudience','prerequisites',\r\n        'requirements','accomodations','passingScore','lockedSequence','isPublic',\r\n        'orgId','orgType','healthMeta','releaseAt','publishedAt','exipirationDate',\r\n        'confirmAt','confirmBy','confirmMessage'\r\n      ])\r\n      && isString(d.title)\r\n      && isString(d.description)\r\n      && isString(d.lang)\r\n      && isNumber(d.durationMin)\r\n      && isBool(d.active)\r\n      && isString(d.kind)\r\n      && (!('subtitle' in d) || isString(d.subtitle))\r\n      && (!('ceCredit' in d) || isNumber(d.ceCredit))\r\n      && (!('tags' in d) || d.tags is list)\r\n      && (!('imageUrl' in d) || isString(d.imageUrl))\r\n      && (!('sections' in d) || d.sections is list)\r\n      && (!('url' in d) || isString(d.url))\r\n      && (!('code' in d) || isString(d.code))\r\n      && (!('type' in d) || isString(d.type))\r\n      && (!('level' in d) || isString(d.level))\r\n      && (!('lecturer' in d) || isString(d.lecturer))\r\n      && (!('disclosures' in d) || d.disclosures is list)\r\n      && (!('targetAudience' in d) || d.targetAudience is list)\r\n      && (!('prerequisites' in d) || d.prerequisites is list)\r\n      && (!('requirements' in d) || d.requirements is list)\r\n      && (!('accomodations' in d) || isString(d.accomodations))\r\n      && (!('passingScore' in d) || isNumber(d.passingScore))\r\n      && (!('lockedSequence' in d) || isBool(d.lockedSequence))\r\n      && (!('isPublic' in d) || isBool(d.isPublic))\r\n      && (!('orgId' in d) || d.orgId == null || isString(d.orgId))\r\n      && (!('orgType' in d) || isString(d.orgType))\r\n      && (!('healthMeta' in d) || d.healthMeta is map)\r\n      && (!('releaseAt' in d) || d.releaseAt is timestamp)\r\n      && (!('publishedAt' in d) || d.publishedAt is timestamp)\r\n      && (!('exipirationDate' in d) || d.exipirationDate is timestamp)\r\n      && (!('confirmAt' in d) || d.confirmAt is timestamp)\r\n      && (!('confirmBy' in d) || isString(d.confirmBy))\r\n      && (!('confirmMessage' in d) || isString(d.confirmMessage));\r\n    }\r\n\r\n    function validCert(d) {\r\n      return hasOnlyKeys(d, ['code','name','credit'])\r\n        && isString(d.code)\r\n        && isString(d.name)\r\n        && isString(d.credit);\r\n    }\r\n\r\n    function validExam(d) {\r\n      return hasOnlyKeys(d, ['title','questions','available','url','createdAt','updatedAt','passPct'])\r\n        && isString(d.title)\r\n        && isNumber(d.questions)\r\n        && d.questions >= 1\r\n        && isBool(d.available)\r\n        && (!('url' in d) || isString(d.url));\r\n    }\r\n\r\n    function validWound(d) {\r\n      return hasOnlyKeys(d, [\r\n        'id','name','aliases','category','stage','definition','pathophysiology',\r\n        'clinical_features','common_sites','risk_factors','assessment','interventions',\r\n        'topical_treatments','expected_healing_time','documentation_example',\r\n        'prevention','images','references','tags','createdAt','updatedAt','locale'\r\n      ])\r\n      && (d.id is string)\r\n      && (d.name is string)\r\n      && (d.definition is string);\r\n    }\r\n\r\n    // ---------- VALIDATORS FOR COMMON MODELS ----------\r\n    function validPolicy(d) {\r\n      return (d.title is string && d.title.size() > 0)\r\n        && (d.content is string && d.content.size() > 0)\r\n        && (d.version is string || d.version is number)\r\n        && (d.createdAt is timestamp)\r\n        && ((!('updatedAt' in d)) || d.updatedAt is timestamp);\r\n    }\r\n\r\n    // ---------- Admin allow-list doc ----------\r\n    match /admins/{uid} {\r\n      allow read, write: if false; // managed server-side/console only\r\n    }\r\n\r\n    // ---------- USERS ----------\r\n    match /users/{uid} {\r\n      allow read: if isSuperAdmin()\r\n        || (isSignedIn() && request.auth.uid == uid)\r\n        || (\r\n          // SECURITY (P3-Step 2): membership-based. Reader must hold an active\r\n          // org_admin/program_admin membership in the target user's org.\r\n          isSignedIn()\r\n          && resource.data.orgId is string\r\n          && isOrgAdmin(resource.data.orgId)\r\n        );\r\n\r\n      // super_admin full control\r\n      // org admin can manage users of their org only via active membership\r\n      // self-write cannot change role/orgId/active\r\n      allow create: if isSuperAdmin()\r\n        || (\r\n          // SECURITY (P3-Step 2): creator must hold an active org_admin/\r\n          // program_admin membership in the target org. Legacy global admin\r\n          // role checks have been removed.\r\n          isSignedIn()\r\n          && request.resource.data.orgId is string\r\n          && isOrgAdmin(request.resource.data.orgId)\r\n          && request.resource.data.role in [\"admin\", \"manager\", \"org_admin\", \"org_manager\", \"learner\", \"org_learner\", \"guest\"]\r\n        )\r\n        // SECURITY: a self-created profile (public signup) MUST stay org-less.\r\n        // It can only become attached to an org via a userOrgMembership written\r\n        // by a super_admin. We no longer accept the legacy public-org id here:\r\n        // any pre-assignment to a real org from the client side is a tenant leak.\r\n        || (\r\n          isSignedIn()\r\n          && request.auth.uid == uid\r\n          && request.resource.data.role == \"guest\"\r\n          && (\r\n            !('orgId' in request.resource.data)\r\n            || request.resource.data.orgId == null\r\n          )\r\n        );\r\n\r\n      allow update: if isSuperAdmin()\r\n        || (\r\n          // SECURITY (P3-Step 2): updater must hold an active org_admin/\r\n          // program_admin membership in the target user's org and the orgId\r\n          // assignment cannot be changed (only super_admin can move a user\r\n          // across orgs).\r\n          isSignedIn()\r\n          && resource.data.orgId is string\r\n          && isOrgAdmin(resource.data.orgId)\r\n          && request.resource.data.orgId == resource.data.orgId\r\n          && request.resource.data.role in [\"admin\", \"manager\", \"org_admin\", \"org_manager\", \"learner\", \"org_learner\", \"guest\"]\r\n        )\r\n        || (\r\n          isSignedIn() && request.auth.uid == uid\r\n          && request.resource.data.role == resource.data.role\r\n          && request.resource.data.active == resource.data.active\r\n          && request.resource.data.orgId == resource.data.orgId\r\n        );\r\n\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ---------- USER ORG MEMBERSHIPS (multi-tenant authorization source) ----------\r\n    // Each document id is `${userId}__${orgId}`. The role/status here is the\r\n    // authoritative source of truth for org-scoped admin powers. Only the\r\n    // super_admin can write; the membership owner and org admins of the same\r\n    // org can read.\r\n    match /userOrgMemberships/{membershipId} {\r\n      allow read: if isSuperAdmin()\r\n        || (isSignedIn() && resource.data.userId == request.auth.uid)\r\n        || (isSignedIn() && isOrgAdmin(resource.data.orgId));\r\n\r\n      allow create, update, delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ---------- ORGANIZATIONS (multi-tenant boundary) ----------\r\n    match /organizations/{orgId} {\r\n      // Needed for organization-code login lookup; only active orgs are visible publicly.\r\n      allow read: if ((!('active' in resource.data)) || resource.data.active == true)\r\n        || isSuperAdmin()\r\n        || isOrgMember(orgId)\r\n        || isOrgAdmin(orgId);\r\n\r\n      allow create, update, delete: if isSuperAdmin();\r\n\r\n      match /orgUsers/{uid} {\r\n        allow read: if isSuperAdmin() || isOrgMember(orgId) || isOrgAdmin(orgId);\r\n        allow create, update, delete: if false;\r\n      }\r\n\r\n      // ---------- STRICT ORG-SCOPED DOMAIN ----------\r\n      match /users/{uid} {\r\n        allow read: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && request.auth.uid == uid);\r\n\r\n        allow create, update: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n        allow delete: if isSuperAdmin() || isOrgAdmin(orgId);\r\n      }\r\n\r\n      // Canonical path for courses assigned by platform to organization.\r\n      match /assignedCourses/{courseId} {\r\n        allow read: if isSuperAdmin() || isOrgMember(orgId);\r\n        // Platform owner assigns courses to organizations.\r\n        allow create, update, delete: if isSuperAdmin();\r\n      }\r\n\r\n      // Backward compatibility path.\r\n      match /courses/{courseId} {\r\n        allow read: if isSuperAdmin() || isOrgMember(orgId);\r\n        allow create, update, delete: if isSuperAdmin();\r\n      }\r\n\r\n      match /courseAssignments/{assignmentId} {\r\n        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n\r\n        // Org admin/manager can assign only approved org courses to users of same org.\r\n        allow create: if isSuperAdmin()\r\n          || (\r\n            (isOrgAdmin(orgId) || isOrgManager(orgId))\r\n            && request.resource.data.orgId == orgId\r\n            && request.resource.data.userId is string\r\n            && hasOrgUser(orgId, request.resource.data.userId)\r\n            && request.resource.data.courseId is string\r\n            && (\r\n              hasOrgCourse(orgId, request.resource.data.courseId)\r\n              || exists(/databases/$(database)/documents/organizations/$(orgId)/assignedCourses/$(request.resource.data.courseId))\r\n            )\r\n          );\r\n\r\n        allow update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /enrollments/{enrollmentId} {\r\n        allow read: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);\r\n\r\n        allow create, update: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n        allow delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /progress/{progressId} {\r\n        allow read: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);\r\n\r\n        allow create, update: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && request.resource.data.userId == request.auth.uid);\r\n\r\n        allow delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /overdue/{recordId} {\r\n        allow read: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);\r\n\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /policies/{policyId} {\r\n        allow read: if isSuperAdmin() || isOrgMember(orgId);\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /policyAcknowledgments/{ackId} {\r\n        allow read: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);\r\n\r\n        allow create, update: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && request.resource.data.userId == request.auth.uid);\r\n\r\n        allow delete: if isSuperAdmin() || isOrgAdmin(orgId);\r\n      }\r\n\r\n      match /woundLibrary/{itemId} {\r\n        allow read: if isSuperAdmin() || isOrgMember(orgId);\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /documents/{documentId} {\r\n        allow read: if isSuperAdmin() || isOrgMember(orgId);\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId);\r\n      }\r\n\r\n      match /reports/{reportId} {\r\n        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /alerts/{alertId} {\r\n        allow read: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && resource.data.assignedTo == request.auth.uid);\r\n\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /followUpActions/{actionId} {\r\n        allow read: if isSuperAdmin()\r\n          || isOrgAdmin(orgId)\r\n          || isOrgManager(orgId)\r\n          || (isOrgMember(orgId) && resource.data.assignedTo == request.auth.uid);\r\n\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /auditLogs/{logId} {\r\n        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n        allow create: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n        allow update, delete: if false;\r\n      }\r\n\r\n      match /troubleshootingIssues/{issueId} {\r\n        allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n        allow create, update, delete: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      }\r\n\r\n      match /examPrograms/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /examCourseGroups/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /examModules/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /questionBank/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /caseStudies/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /examBlueprints/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /assessmentDefinitions/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /jurisdictionOverlays/{docId} {\r\n        allow read, create, update, delete: if canManageProgramOrg(orgId);\r\n      }\r\n\r\n      match /attemptSessions/{docId} {\r\n        allow read: if canManageProgramOrg(orgId)\r\n          || (isSignedIn() && hasMembership(orgId) && resource.data.learnerId == request.auth.uid);\r\n        allow create, update: if canManageProgramOrg(orgId);\r\n        allow delete: if false;\r\n\r\n        match /events/{eventId} {\r\n          allow read: if canManageProgramOrg(orgId)\r\n            || (\r\n              isSignedIn()\r\n              && hasMembership(orgId)\r\n              && get(/databases/$(database)/documents/organizations/$(orgId)/attemptSessions/$(docId)).data.learnerId == request.auth.uid\r\n            );\r\n          allow create, update, delete: if false;\r\n        }\r\n      }\r\n\r\n      match /attemptReviewSnapshots/{docId} {\r\n        allow read: if canManageProgramOrg(orgId)\r\n          || (isSignedIn() && hasMembership(orgId) && resource.data.learnerId == request.auth.uid);\r\n        allow create, update: if canManageProgramOrg(orgId);\r\n        allow delete: if false;\r\n      }\r\n    }\r\n\r\n    // Legacy path compatibility: /org/{orgId}/orgUsers/{uid}\r\n    match /org/{orgId}/orgUsers/{uid} {\r\n      allow read: if isSuperAdmin() || isOrgMember(orgId) || isOrgAdmin(orgId);\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /organizationCourseAssignments/{assignmentId} {\r\n      allow read: if isSuperAdmin()\r\n        || (resource.data.orgId is string && isOrgMember(resource.data.orgId));\r\n\r\n      allow create, update, delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /adminLogs/{logId} {\r\n      allow read, create: if isSuperAdmin();\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // ---------- USER COMMERCE DATA (owner-read, sensitive server-write) ----------\r\n    match /users/{uid}/carts/{cartId} {\r\n        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)\r\n        || (\r\n          isSignedIn() && request.auth.uid == uid\r\n          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))\r\n        );\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /users/{uid}/orders/{orderId} {\r\n        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)\r\n        || (\r\n          isSignedIn() && request.auth.uid == uid\r\n          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))\r\n        );\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /payments/{paymentId} {\r\n      allow read: if canReadManagedUserPrivateData(resource.data.userId, resource.data.orgId);\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /users/{uid}/guestEnrollments/{enrollmentId} {\r\n        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)\r\n        || (\r\n          isSignedIn() && request.auth.uid == uid\r\n          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))\r\n        );\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /users/{uid}/guestPrograms/{programAccessId} {\r\n        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)\r\n        || (\r\n          isSignedIn() && request.auth.uid == uid\r\n          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))\r\n        );\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /users/{uid}/bookings/{bookingId} {\r\n        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)\r\n        || (\r\n          isSignedIn() && request.auth.uid == uid\r\n          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))\r\n        );\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /users/{uid}/programLiveSessionBookings/{bookingId} {\r\n        allow read: if canReadManagedUserPrivateData(uid, resource.data.orgId)\r\n        || (\r\n          isSignedIn() && request.auth.uid == uid\r\n          && (!('orgId' in resource.data) || sameRequesterOrg(resource.data.orgId))\r\n        );\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    match /users/{uid}/notificationReads/{notificationId} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update: if canManageUser(uid);\r\n      allow delete: if isSuperAdmin() || isOwner(uid);\r\n    }\r\n\r\n    match /users/{uid}/notifications/{notificationId} {\r\n      allow read: if canManageUser(uid);\r\n      allow update: if canManageUser(uid);\r\n      allow create: if false;\r\n      allow delete: if isSuperAdmin() || isOwner(uid);\r\n    }\r\n\r\n    match /users/{uid}/preferences/{preferenceId} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update: if canManageUser(uid);\r\n      allow delete: if isSuperAdmin() || isOwner(uid);\r\n    }\r\n\r\n    match /users/{uid}/licenses/{licenseId} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update, delete: if canManageUser(uid);\r\n    }\r\n\r\n    match /users/{uid}/enrollments/{courseId} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update: if isSuperAdmin() || isOwner(uid) || canAssignLearner(uid);\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /users/{uid}/launchTickets/{ticketId} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update: if canManageUser(uid);\r\n      allow delete: if isSuperAdmin() || isOwner(uid);\r\n    }\r\n\r\n    match /users/{uid}/wallet/{walletId} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update: if canManageUser(uid);\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /users/{uid}/rewards/{rewardId} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update: if canManageUser(uid);\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ---------- SERVICES (public read; admin write) ----------\r\n    match /services/{id} {\r\n      allow read: if true;\r\n      allow write: if isAdmin()\r\n        && request.resource.data.keys().hasOnly(\r\n            ['title','slug','active','blurb','bullets','category','image','duration','order']\r\n           )\r\n        && (request.resource.data.title is string)\r\n        && (request.resource.data.slug is string)\r\n        && (request.resource.data.active is bool);\r\n    }\r\n\r\n    // ---------- COURSES & OFFERS (public catalogue read) ----------\r\n    match /courses/{courseId} {\r\n      allow read: if true;\r\n      allow create, update: if isSuperAdmin() && validCourse(request.resource.data);\r\n      allow delete: if isSuperAdmin();\r\n\r\n      match /certifications/{id} {\r\n        allow read: if isSignedIn();\r\n        allow create, update, delete: if isSuperAdmin() && validCert(request.resource.data);\r\n      }\r\n\r\n      match /modules/{moduleId} {\r\n        allow read: if true;\r\n        allow write: if isSuperAdmin();\r\n      }\r\n\r\n      match /exams/{examId} {\r\n        allow read: if isSignedIn();\r\n        allow create, update, delete: if isSuperAdmin() && validExam(request.resource.data);\r\n\r\n        match /questions/{questionId} {\r\n          allow read: if isSignedIn();\r\n          allow create, update, delete: if isSuperAdmin();\r\n        }\r\n\r\n        match /answerKey/{questionId} {\r\n          allow read, create, update, delete: if isSuperAdmin();\r\n        }\r\n      }\r\n    }\r\n\r\n    match /exams/{examId} {\r\n      allow read: if true;\r\n      allow write: if isSuperAdmin();\r\n\r\n      match /questions/{questionId} {\r\n        allow read: if true;\r\n        allow write: if isSuperAdmin();\r\n      }\r\n    }\r\n\r\n    // ---------- EVENTS & REGISTRATIONS ----------\r\n    match /events/{eventId} {\r\n      // Authenticated users can read\r\n      allow read: if request.auth != null;\r\n      // Only admins can create/update/delete\r\n      allow create, update, delete: if isAdmin();\r\n\r\n      match /registrations/{uid} {\r\n        // Admin or owner can read\r\n        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);\r\n        // Owner can self-register\r\n        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == uid;\r\n        // Admin or owner can delete\r\n        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);\r\n        // No updates allowed\r\n        allow update: if false;\r\n      }\r\n    }\r\n\r\n    // ---------- TIMESHEETS & ENTRIES ----------\r\n    match /timesheets/{tsId} {\r\n      function belongsTo(uid) { return isSignedIn() && tsId.split('_')[0] == uid; }\r\n\r\n      allow read: if isSignedIn() && (belongsTo(request.auth.uid) || isAdmin());\r\n      allow create: if isSignedIn() && belongsTo(request.auth.uid);\r\n\r\n      allow update: if isSignedIn() && (\r\n        (belongsTo(request.auth.uid) &&\r\n          !('approvedAt' in request.resource.data) &&\r\n          !('approvedBy' in request.resource.data)) ||\r\n        (isAdmin() &&\r\n          request.resource.data.diff(resource.data).changedKeys()\r\n            .hasOnly(['status','approvedAt','approvedBy','updatedAt','totalHours']))\r\n      );\r\n      allow delete: if isAdmin();\r\n\r\n      match /entries/{entryId} {\r\n        allow read: if isSignedIn() && (belongsTo(request.auth.uid) || isAdmin());\r\n        allow create, update: if isSignedIn() && (\r\n          (belongsTo(request.auth.uid) &&\r\n            (get(/databases/$(database)/documents/timesheets/$(tsId)).data.status in ['open','submitted'])) ||\r\n          isAdmin()\r\n        );\r\n        allow delete: if isAdmin();\r\n      }\r\n    }\r\n\r\n    // ---------- NOTIFICATIONS (consolidated) ----------\r\n    match /notifications/{notificationId} {\r\n      allow read, create, update, delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /demoRequests/{requestId} {\r\n      allow create: if request.time < timestamp.date(2099,1,1)\r\n        && request.resource.data.keys().hasOnly([\r\n          'fullName',\r\n          'workEmail',\r\n          'phone',\r\n          'organizationName',\r\n          'organizationType',\r\n          'selectedPlan',\r\n          'message',\r\n          'source',\r\n          'status',\r\n          'createdAt'\r\n        ])\r\n        && request.resource.data.fullName is string\r\n        && request.resource.data.fullName.size() > 0\r\n        && request.resource.data.workEmail is string\r\n        && request.resource.data.workEmail.size() > 0\r\n        && request.resource.data.phone is string\r\n        && request.resource.data.organizationName is string\r\n        && request.resource.data.organizationType is string\r\n        && request.resource.data.selectedPlan is string\r\n        && request.resource.data.message is string\r\n        && request.resource.data.source is string\r\n        && request.resource.data.status == 'new';\r\n\r\n      allow read, update: if isAdmin();\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /billingRecords/{recordId} {\r\n      allow read, create, update, delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /certificates/{certificateId} {\r\n      allow read: if isSuperAdmin()\r\n        || (\r\n          isSignedIn()\r\n          && resource.data.uid is string\r\n          && canManageUser(resource.data.uid)\r\n        )\r\n        || (\r\n          // Automation v1 writes `userId` instead of `uid` — let the learner\r\n          // read their own certificate without going through the callable.\r\n          isSignedIn()\r\n          && resource.data.userId is string\r\n          && request.auth.uid == resource.data.userId\r\n        )\r\n        || (\r\n          // Org admins can read certificates issued under their organization.\r\n          resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && isOrgAdmin(resource.data.orgId)\r\n        );\r\n\r\n      allow create, update: if isSuperAdmin()\r\n        || (\r\n          isSignedIn()\r\n          && request.resource.data.uid is string\r\n          && canManageUser(request.resource.data.uid)\r\n        );\r\n\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Enrollments (automation v1 — top-level collection)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /enrollments/{enrollmentId} {\r\n      // Writes go through Cloud Functions (admin SDK bypasses these rules):\r\n      // createCheckoutSession → stripeWebhook → handleAutomationCheckoutCompleted.\r\n      allow create: if false;\r\n\r\n      allow read: if isSuperAdmin()\r\n        || (\r\n          isSignedIn()\r\n          && resource.data.userId is string\r\n          && request.auth.uid == resource.data.userId\r\n        )\r\n        || (\r\n          resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && isOrgAdmin(resource.data.orgId)\r\n        );\r\n\r\n      // The learner can flip status from \"active\" to \"completed\" so the\r\n      // onEnrollmentCompleted trigger picks it up. Everything else is\r\n      // server-only.\r\n      allow update: if isSuperAdmin()\r\n        || (\r\n          isSignedIn()\r\n          && resource.data.userId is string\r\n          && request.auth.uid == resource.data.userId\r\n          && request.resource.data.diff(resource.data).affectedKeys()\r\n              .hasOnly(['status', 'progress', 'updatedAt'])\r\n          && request.resource.data.status in ['active', 'completed']\r\n        );\r\n\r\n      allow delete: if false;\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Organization settings (per-org configuration documents)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /orgSettings/{orgId} {\r\n      allow read: if isSuperAdmin() || isOrgAdmin(orgId) || isOrgManager(orgId);\r\n      allow write: if isSuperAdmin() || isOrgAdmin(orgId);\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Lead capture (public marketing form → triage by org admins)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /leadCapture/{leadId} {\r\n      // Anyone (signed in or not) may submit a lead, but the payload must\r\n      // look like a lead and cannot pre-set internal fields.\r\n      allow create: if request.resource.data.keys().hasOnly([\r\n            'name', 'phone', 'email', 'country', 'interest',\r\n            'source', 'orgId', 'createdAt', 'status',\r\n          ])\r\n        && (request.resource.data.email is string\r\n            || request.resource.data.phone is string)\r\n        && request.resource.data.status == 'new';\r\n      allow read, update: if isSuperAdmin()\r\n        || (\r\n          resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && (isOrgAdmin(resource.data.orgId) || isOrgManager(resource.data.orgId))\r\n        );\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /publicOffers/{offerId} {\r\n      allow read: if (resource.data.isActive == true && resource.data.isPublic == true)\r\n        || sameRequesterOrg(resource.data.orgId)\r\n        || isAdmin();\r\n      allow create: if isSuperAdmin() && validPublicOfferPayload();\r\n      allow update: if isSuperAdmin()\r\n        && validPublicOfferPayload()\r\n        && request.resource.data.createdAt == resource.data.createdAt;\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ---------- WOUND LIBRARY ----------\r\n    match /woundLibrary/{docId} {\r\n      // Authenticated users can read\r\n      allow read: if request.auth != null;\r\n      // Only admins can create/update/delete\r\n      allow create, update: if isSuperAdmin() && validWound(request.resource.data);\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    match /wounds/{docId} {\r\n      // Authenticated users can read\r\n      allow read: if request.auth != null;\r\n      // Only admins can create/update/delete\r\n      allow create, update: if isSuperAdmin() && validWound(request.resource.data);\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ---------- COURSE ASSIGNMENTS ----------\r\n    match /courseAssignments/{docId} {\r\n      // Authenticated users can read\r\n      allow read: if request.auth != null;\r\n      // SECURITY (P3-Step 2): super_admin OR an active org_admin/program_admin\r\n      // membership in the target learner's org. Legacy users.role checks have\r\n      // been removed.\r\n      allow create, update, delete: if isSuperAdmin()\r\n        || (\r\n          isSignedIn()\r\n          && (\r\n            (\r\n              request.resource.data.userId is string\r\n              && hasUser(request.resource.data.userId)\r\n              && targetUserOrgId(request.resource.data.userId) is string\r\n              && isOrgAdmin(targetUserOrgId(request.resource.data.userId))\r\n              && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.role == \"learner\"\r\n            )\r\n            ||\r\n            (\r\n              resource.data.userId is string\r\n              && hasUser(resource.data.userId)\r\n              && targetUserOrgId(resource.data.userId) is string\r\n              && isOrgAdmin(targetUserOrgId(resource.data.userId))\r\n              && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.role == \"learner\"\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    // ---------- PROGRAMS ----------\r\n    match /programs/{programId} {\r\n      allow read: if (\r\n          resource.data.active == true\r\n          && resource.data.status == \"PUBLISHED\"\r\n        )\r\n          || (\r\n            isSignedIn()\r\n            && resource.data.orgId is string\r\n            && resource.data.orgId.size() > 0\r\n            && sameRequesterOrg(resource.data.orgId)\r\n          )\r\n          || canManageProgramOrg(resource.data.orgId);\r\n\r\n        allow create: if canManageProgramOrg(request.resource.data.orgId)\r\n          && request.resource.data.orgId is string\r\n          && request.resource.data.orgId.size() > 0;\r\n\r\n        allow update: if canManageProgramOrg(resource.data.orgId)\r\n          && resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && request.resource.data.orgId == resource.data.orgId;\r\n\r\n        allow delete: if canManageProgramOrg(resource.data.orgId)\r\n          && resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0;\r\n\r\n      match /modules/{moduleId} {\r\n        allow read: if (\r\n            get(/databases/$(database)/documents/programs/$(programId)).data.active == true\r\n            && get(/databases/$(database)/documents/programs/$(programId)).data.status == \"PUBLISHED\"\r\n          )\r\n            || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n\r\n      match /lessons/{lessonId} {\r\n        allow read: if (\r\n            get(/databases/$(database)/documents/programs/$(programId)).data.active == true\r\n            && get(/databases/$(database)/documents/programs/$(programId)).data.status == \"PUBLISHED\"\r\n          )\r\n            || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n\r\n      match /simulations/{simulationId} {\r\n          allow read: if isProgramLearner() || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n\r\n      match /caseStudies/{caseStudyId} {\r\n          allow read: if isProgramLearner() || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n\r\n      match /assessments/{assessmentId} {\r\n          allow read: if isProgramLearner() || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n\r\n      match /documents/{documentId} {\r\n          allow read: if isProgramLearner() || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n\r\n      match /liveSessions/{sessionId} {\r\n          allow read: if isProgramLearner() || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n\r\n      match /resources/{resourceId} {\r\n          allow read: if isProgramLearner() || canManageProgramById(programId);\r\n          allow create, update, delete: if canManageProgramById(programId);\r\n      }\r\n    }\r\n\r\n    match /programEnrollments/{enrollmentId} {\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.keys().hasOnly([\r\n          'programId',\r\n          'userId',\r\n          'programTitle',\r\n          'category',\r\n          'learnerName',\r\n          'learnerEmail',\r\n          'learnerPhone',\r\n          'notes',\r\n          'status',\r\n          'amount',\r\n          'currency',\r\n          'paymentStatus',\r\n          'reviewStatus',\r\n          'enrolledAt',\r\n          'activatedAt',\r\n          'completedAt',\r\n          'orgId',\r\n          'createdAt',\r\n          'updatedAt'\r\n        ])\r\n        && isOwner(request.resource.data.userId)\r\n        && request.resource.data.programId is string\r\n        && request.resource.data.programTitle is string\r\n        && request.resource.data.learnerName is string\r\n        && request.resource.data.learnerEmail is string\r\n        && request.resource.data.learnerPhone is string\r\n        && request.resource.data.orgId == programDocOrgId(request.resource.data.programId)\r\n        && request.resource.data.status == 'pending'\r\n        && request.resource.data.paymentStatus == 'unpaid'\r\n        && request.resource.data.reviewStatus == 'pending_review';\r\n\r\n      allow read: if canManageProgramOrg(resource.data.orgId)\r\n        || canManageProgramById(resource.data.programId)\r\n        || isOwner(resource.data.userId);\r\n\r\n      allow update: if (\r\n          canManageProgramOrg(resource.data.orgId)\r\n          || canManageProgramById(resource.data.programId)\r\n          || (\r\n            isOwner(resource.data.userId)\r\n            && resource.data.status == 'pending'\r\n            && resource.data.paymentStatus in ['unpaid', 'pending']\r\n          )\r\n        )\r\n        && request.resource.data.userId == resource.data.userId\r\n        && request.resource.data.programId == resource.data.programId\r\n        && request.resource.data.programTitle == resource.data.programTitle\r\n        && request.resource.data.status in ['pending', 'approved', 'active', 'completed', 'cancelled', 'rejected']\r\n        && request.resource.data.paymentStatus in ['unpaid', 'pending', 'paid', 'refunded']\r\n        && request.resource.data.reviewStatus in ['pending_review', 'approved', 'denied'];\r\n\r\n      allow delete: if canManageProgramOrg(resource.data.orgId)\r\n        || canManageProgramById(resource.data.programId);\r\n    }\r\n\r\n    match /programSubscriptions/{subscriptionId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /users/{uid}/programProgress/{programId} {\r\n        allow read: if canManageProgramById(programId) || isOwner(uid);\r\n        allow create, update: if canManageProgramById(programId) || isOwner(uid);\r\n        allow delete: if canManageProgramById(programId);\r\n    }\r\n\r\n    match /users/{uid}/moduleProgress/{moduleId} {\r\n        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);\r\n        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);\r\n        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);\r\n    }\r\n\r\n    match /users/{uid}/simulationAttempts/{attemptId} {\r\n        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);\r\n        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);\r\n        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);\r\n    }\r\n\r\n    match /users/{uid}/assessmentAttempts/{attemptId} {\r\n        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);\r\n        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);\r\n        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);\r\n    }\r\n\r\n    match /users/{uid}/lessonProgress/{lessonId} {\r\n        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);\r\n        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);\r\n        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);\r\n    }\r\n\r\n    match /users/{uid}/caseStudyAttempts/{attemptId} {\r\n        allow read: if (resource.data.programId is string && canManageProgramById(resource.data.programId)) || isOwner(uid);\r\n        allow create, update: if (request.resource.data.programId is string && canManageProgramById(request.resource.data.programId)) || isOwner(uid);\r\n        allow delete: if resource.data.programId is string && canManageProgramById(resource.data.programId);\r\n    }\r\n\r\n    // ---------- POLICIES (read by all authenticated; write by admin/manager) ----------\r\n    match /policies/{policyId} {\r\n      // Authenticated users can read all policies\r\n      allow read: if request.auth != null;\r\n      // Only admins can create/update with validation\r\n      allow create: if isSuperAdmin() && validPolicy(request.resource.data);\r\n      allow update: if isSuperAdmin() && validPolicy(request.resource.data);\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // Singular alias for compatibility (both /policies and /policy point to same business logic)\r\n    match /policy/{policyId} {\r\n      // Authenticated users can read all policies\r\n      allow read: if request.auth != null;\r\n      // Only admins can create/update with validation\r\n      allow create: if isSuperAdmin() && validPolicy(request.resource.data);\r\n      allow update: if isSuperAdmin() && validPolicy(request.resource.data);\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ---------- LISTENING TEST ENGINE ----------\r\n    match /listeningTestAssessments/{assessmentId} {\r\n      // Learners can read published tests; instructors can read/write all\r\n      allow read: if isSignedIn() && (\r\n        resource.data.status == 'PUBLISHED'\r\n        || isAdmin()\r\n      );\r\n      allow create, update, delete: if isAdmin();\r\n    }\r\n\r\n    match /listeningTestResults/{resultId} {\r\n      // Learner can create their own result\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.learnerId == request.auth.uid;\r\n      // Learner or admin can read\r\n      allow read: if isSignedIn() && (\r\n        resource.data.learnerId == request.auth.uid\r\n        || isAdmin()\r\n      );\r\n      // Learner can update own result (error log); admin can update anything\r\n      allow update: if isSignedIn() && (\r\n        (resource.data.learnerId == request.auth.uid)\r\n        || isAdmin()\r\n      );\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /users/{uid}/listeningProgress/{assessmentId} {\r\n      allow read, write: if isOwner(uid) || isAdmin();\r\n    }\r\n\r\n    match /policy_acknowledgements/{ackId} {\r\n        allow read: if (isSignedIn() && resource.data.userId is string && canManageUser(resource.data.userId))\r\n          || (isSignedIn() && resource.data.userId == request.auth.uid);\r\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // ---------- PATHWAY REQUESTS ----------\r\n    match /pathwayRequests/{requestId} {\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.keys().hasOnly([\r\n          'courseId',\r\n          'courseTitle',\r\n          'source',\r\n          'status',\r\n          'requesterUid',\r\n          'addedAt'\r\n        ])\r\n        && request.resource.data.courseId is string\r\n        && request.resource.data.courseId.size() > 0\r\n        && request.resource.data.courseTitle is string\r\n        && request.resource.data.courseTitle.size() > 0\r\n        && request.resource.data.source is string\r\n        && request.resource.data.status == 'new'\r\n        && request.resource.data.requesterUid == request.auth.uid\r\n        && request.resource.data.addedAt is timestamp;\r\n\r\n      allow read: if isAdmin()\r\n        || (isSignedIn() && resource.data.requesterUid == request.auth.uid);\r\n\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n    // ---------- CONTACTS (public create; admin read/update) ----------\r\n    match /contacts/{doc} {\r\n      allow create: if request.auth == null\r\n        && request.time < timestamp.date(2099,1,1)\r\n        && request.resource.data.keys().hasOnly(\r\n             ['name','email','phone','reason','message','createdAt','status','userAgent','page']\r\n           )\r\n        && request.resource.data.status == 'new'\r\n        && request.resource.data.createdAt == request.time;\r\n      allow read, update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n   // ---------- BOOKINGS (public create; admin read/update) ----------\r\nmatch /bookings/{doc} {\r\n  // Allow any visitor (signed-in or not) to create a booking\r\n  allow create: if\r\n      (request.auth == null || request.auth != null)\r\n      && request.time < timestamp.date(2099,1,1)\r\n      // If you enable App Check, uncomment next line:\r\n      // && request.appcheck.token != null\r\n      // Only allow the exact schema your client sends\r\n      && request.resource.data.keys().hasOnly([\r\n           'serviceSlug','serviceTitle',\r\n           'patient','preference','contact',\r\n           'status','createdAt','userAgent'\r\n         ])\r\n      // Validate nested shapes\r\n      && request.resource.data.patient.keys().hasOnly([\r\n           'firstName','lastName','dob','woundType','notes'\r\n         ])\r\n      && request.resource.data.preference.keys().hasOnly([\r\n           'mode','preferredDate','preferredTime','address'\r\n         ])\r\n      && request.resource.data.contact.keys().hasOnly([\r\n           'name','phone','email','refSource'\r\n         ])\r\n      // Initial status & createdAt must be \"now\"\r\n      && request.resource.data.status == 'pending'\r\n      && request.resource.data.createdAt == request.time;\r\n\r\n  // Only admins can read/update bookings\r\n  allow read, update: if isAdmin();\r\n\r\n  // No deletes from clients\r\n  allow delete: if false;\r\n}\r\n\r\n\r\n\r\n    // ---------- REFERRALS (public create; admin read/update) ----------\r\n    match /patientReferal/{doc} {\r\n      allow create: if request.auth == null\r\n        && request.time < timestamp.date(2099,1,1)\r\n        && request.resource.data.keys().hasOnly([\r\n             'serviceSlug','serviceTitle',\r\n             'refType','refName','refOrg','refRole','refEmail','refPhone',\r\n             'patientName','patientDob','patientArea',\r\n             'diagnosis','urgency','notes',\r\n             'contactPref','consent',\r\n             'createdAt','status','page','userAgent'\r\n           ])\r\n        && request.resource.data.status == 'new'\r\n        && request.resource.data.createdAt == request.time;\r\n      allow read, update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    // ---------- TASKS & subcollections ----------\r\n    // Task schema (canonical fields)\r\n    // { createdAt, createdBy, source, patient, service, scheduledAt, status, assignedTo, notes, lastUpdatedAt }\r\n    match /tasks/{taskId} {\r\n\r\n      // Admin can read; clinician can read IF assigned\r\n      allow read: if isAdmin() || (isClinician() && isAssignedTo(resource.data));\r\n\r\n      // Admin creates tasks with strict schema\r\n      allow create: if isAdmin()\r\n        && request.resource.data.keys().hasOnly([\r\n             'createdAt','createdBy','source','patient','service',\r\n             'scheduledAt','status','assignedTo','notes','lastUpdatedAt'\r\n           ])\r\n        && (request.resource.data.status in ['new','assigned','in_progress','done','cancelled']);\r\n\r\n      // Updates\r\n      // - Admin: any update\r\n      // - Clinician (assignee): can START (-> in_progress), progress, or mark DONE/CANCELLED.\r\n      //   Immutable fields must stay identical.\r\n      //   lastUpdatedAt must move forward.\r\n      allow update: if isAdmin()\r\n        || (\r\n          isClinician()\r\n          && isAssignedTo(resource.data)\r\n\r\n          // Immutable fields unchanged by clinician\r\n          && request.resource.data.assignedTo == resource.data.assignedTo\r\n          && request.resource.data.source     == resource.data.source\r\n          && request.resource.data.patient    == resource.data.patient\r\n          && request.resource.data['service'] == resource.data['service']\r\n          && request.resource.data.createdBy  == resource.data.createdBy\r\n          && request.resource.data.createdAt  == resource.data.createdAt\r\n\r\n          // Only these fields may exist in clinician updates\r\n          && request.resource.data.keys().hasOnly([\r\n               'createdAt','createdBy','source','patient','service',\r\n               'scheduledAt','status','assignedTo','notes','lastUpdatedAt'\r\n             ])\r\n\r\n          // Allowed status values + only forward transitions\r\n          && (request.resource.data.status in ['assigned','in_progress','done','cancelled'])\r\n          && statusTransitionOk(resource.data.status, request.resource.data.status)\r\n\r\n          // Force a forward-moving timestamp on update\r\n          && (request.resource.data.lastUpdatedAt > resource.data.lastUpdatedAt)\r\n        );\r\n\r\n      allow delete: if isAdmin();\r\n\r\n      // ---- NOTES subcollection ----\r\n      // Schema: { createdAt, authorUid, text, followUpAt? }\r\n      match /notes/{noteId} {\r\n        // Admin OR assigned clinician can read notes\r\n        allow read: if isAdmin()\r\n          || (isClinician()\r\n              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));\r\n\r\n        // Create: admin or assigned clinician; author must be current user\r\n        allow create: if isAdmin()\r\n          || (\r\n            isClinician()\r\n            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)\r\n            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text','followUpAt'])\r\n            && request.resource.data.authorUid == request.auth.uid\r\n          );\r\n\r\n        // Update: admin or original author clinician; createdAt/authorUid immutable\r\n        allow update: if isAdmin()\r\n          || (\r\n            isClinician()\r\n            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)\r\n            && (request.auth.uid == resource.data.authorUid)\r\n            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text','followUpAt'])\r\n            && request.resource.data.authorUid == resource.data.authorUid\r\n            && request.resource.data.createdAt == resource.data.createdAt\r\n          );\r\n\r\n        // Delete: admin or original author clinician\r\n        allow delete: if isAdmin()\r\n          || (\r\n            isClinician()\r\n            && (request.auth.uid == resource.data.authorUid)\r\n            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)\r\n          );\r\n      }\r\n\r\n      // ---- VISITS (optional) ----\r\n      match /visits/{visitId} {\r\n        allow read: if isAdmin()\r\n          || (isClinician()\r\n              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));\r\n\r\n        allow create: if isAdmin()\r\n          || (\r\n            isClinician()\r\n            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)\r\n            && request.resource.data.keys().hasOnly(\r\n                 ['createdAt','nurseUid','start','end','notes','outcome','vitals']\r\n               )\r\n            && request.resource.data.nurseUid == request.auth.uid\r\n          );\r\n\r\n        allow update: if isAdmin()\r\n          || (isClinician() && resource.data.nurseUid == request.auth.uid);\r\n\r\n        allow delete: if isAdmin();\r\n      }\r\n\r\n      // ---- MESSAGES (optional) ----\r\n      match /messages/{msgId} {\r\n        allow read: if isAdmin()\r\n          || (isClinician()\r\n              && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data));\r\n        allow create: if isAdmin()\r\n          || (\r\n            isClinician()\r\n            && isAssignedTo(get(/databases/$(database)/documents/tasks/$(taskId)).data)\r\n            && request.resource.data.keys().hasOnly(['createdAt','authorUid','text'])\r\n            && request.resource.data.authorUid == request.auth.uid\r\n          );\r\n        allow update, delete: if isAdmin()\r\n          || (isSignedIn() && request.auth.uid == resource.data.authorUid);\r\n      }\r\n    }\r\n\r\n    // Transactional notification pipeline collections\r\n    match /notificationEvents/{eventId} {\r\n      allow read: if isSuperAdmin()\r\n        || (\r\n          isAdmin()\r\n          && resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && sameRequesterOrg(resource.data.orgId)\r\n        )\r\n        || (isSignedIn() && resource.data.recipientUserId == request.auth.uid);\r\n      allow write: if false;\r\n    }\r\n\r\n    match /notificationTemplates/{templateId} {\r\n      allow read: if isSuperAdmin() || isAdmin();\r\n      allow write: if false;\r\n    }\r\n\r\n    match /notificationLogs/{logId} {\r\n      allow read: if isSuperAdmin()\r\n        || (\r\n          isAdmin()\r\n          && resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && sameRequesterOrg(resource.data.orgId)\r\n        )\r\n        || (isSignedIn() && resource.data.recipientUserId == request.auth.uid);\r\n      allow write: if false;\r\n    }\r\n\r\n    match /notificationPreferences/{uid} {\r\n      allow read: if canManageUser(uid);\r\n      allow create, update: if isOwner(uid)\r\n        || (\r\n          // SECURITY (P3-Step 2): membership-based.\r\n          isSignedIn()\r\n          && hasUser(uid)\r\n          && targetUserOrgId(uid) is string\r\n          && isOrgAdmin(targetUserOrgId(uid))\r\n        );\r\n      allow delete: if isOwner(uid) || isSuperAdmin();\r\n    }\r\n\r\n    // Admin-only collection for in-app pings, etc.\r\n    match /adminNotifications/{id} {\r\n      allow read: if isSuperAdmin()\r\n        || (\r\n          // SECURITY (P3-Step 2): require active org_admin membership in the\r\n          // target organization — not just any platform admin role.\r\n          resource.data.organizationId is string\r\n          && resource.data.organizationId.size() > 0\r\n          && isOrgAdmin(resource.data.organizationId)\r\n        );\r\n      // Allow super_admin or matching org_admin to flip read/readBy ONLY.\r\n      allow update: if (\r\n          isSuperAdmin()\r\n          || (\r\n            resource.data.organizationId is string\r\n            && resource.data.organizationId.size() > 0\r\n            && isOrgAdmin(resource.data.organizationId)\r\n          )\r\n        )\r\n        && request.resource.data.diff(resource.data).affectedKeys()\r\n            .hasOnly(['read', 'readBy']);\r\n      allow create, delete: if false;\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Security Events  (Admin Security Center — Lot 1/2/3/4)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /securityEvents/{eventId} {\r\n      // CREATE: only Cloud Functions / service account (admin SDK bypasses\r\n      // these rules). The frontend uses the `logSecurityEvent` callable.\r\n      allow create: if false;\r\n\r\n      // READ: super_admin sees everything; org_admin sees only events that\r\n      // touch their organization (matches resource.data.orgId OR\r\n      // resource.data.attemptedOrgId).\r\n      allow read: if isSuperAdmin()\r\n        || (\r\n          resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && isOrgAdmin(resource.data.orgId)\r\n        )\r\n        || (\r\n          resource.data.attemptedOrgId is string\r\n          && resource.data.attemptedOrgId.size() > 0\r\n          && isOrgAdmin(resource.data.attemptedOrgId)\r\n        );\r\n\r\n      // UPDATE: only the resolution fields, by super_admin or matching\r\n      // org_admin. Everything else is immutable from the client.\r\n      allow update: if (\r\n          isSuperAdmin()\r\n          || (\r\n            resource.data.orgId is string\r\n            && resource.data.orgId.size() > 0\r\n            && isOrgAdmin(resource.data.orgId)\r\n          )\r\n          || (\r\n            resource.data.attemptedOrgId is string\r\n            && resource.data.attemptedOrgId.size() > 0\r\n            && isOrgAdmin(resource.data.attemptedOrgId)\r\n          )\r\n        )\r\n        && request.resource.data.diff(resource.data).affectedKeys()\r\n            .hasOnly(['resolved', 'resolvedBy', 'resolvedAt', 'resolutionNote'])\r\n        && request.resource.data.resolved == true\r\n        && request.resource.data.resolvedBy == request.auth.uid;\r\n\r\n      // DELETE: never allowed from the client (audit trail must persist).\r\n      allow delete: if false;\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Share Events  (lightweight viral-loop analytics for share buttons)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /shareEvents/{eventId} {\r\n      // CREATE: anyone (auth or anonymous public visitor) may log a share.\r\n      // Strict shape validation prevents abuse / payload pollution.\r\n      allow create: if\r\n        request.resource.data.keys().hasOnly([\r\n          'app','platform','sourcePage','sharedUrl','deviceType',\r\n          'courseId','courseSlug','programId','programSlug',\r\n          'orgId','userId','userRole','createdAt'\r\n        ])\r\n        && request.resource.data.app in ['innovacare_review','sygepec']\r\n        && request.resource.data.platform in [\r\n            'whatsapp','telegram','facebook','x','linkedin','email','copy','native_share'\r\n           ]\r\n        && request.resource.data.sourcePage in [\r\n            'programs_page','program_detail','course_detail','catalogue_page'\r\n           ]\r\n        && request.resource.data.sharedUrl is string\r\n        && request.resource.data.sharedUrl.size() > 0\r\n        && request.resource.data.sharedUrl.size() <= 500\r\n        && request.resource.data.createdAt == request.time\r\n        && (\r\n            !('userId' in request.resource.data)\r\n            || request.resource.data.userId == null\r\n            || (request.auth != null && request.resource.data.userId == request.auth.uid)\r\n           );\r\n\r\n      // READ: super_admin all; org_admin only events from their orgs.\r\n      allow read: if isSuperAdmin()\r\n        || (\r\n          resource.data.orgId is string\r\n          && resource.data.orgId.size() > 0\r\n          && isOrgAdmin(resource.data.orgId)\r\n        );\r\n\r\n      // Immutable from clients.\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Nursing School Courses  (public catalog, admin-managed content)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /nursing_school_courses/{courseId} {\r\n      // Anyone can browse the catalog (isActive checked client-side via query)\r\n      allow read: if true;\r\n      // Only platform admins may add / edit / delete courses\r\n      allow write: if isSuperAdmin() || isAdmin();\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Demo Requests  (institution leads from the For Educators page)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /demo_requests/{requestId} {\r\n      // Admins can read all requests (CRM / sales pipeline view)\r\n      allow read: if isSuperAdmin() || isAdmin();\r\n      // Any visitor (even unauthenticated) may submit a request\r\n      allow create: if\r\n        request.resource.data.keys().hasAll(['institutionName', 'contactName', 'email', 'studentCount', 'programType'])\r\n        && request.resource.data.institutionName is string && request.resource.data.institutionName.size() > 0\r\n        && request.resource.data.institutionName.size() <= 200\r\n        && request.resource.data.contactName is string && request.resource.data.contactName.size() > 0\r\n        && request.resource.data.contactName.size() <= 200\r\n        && request.resource.data.email is string && request.resource.data.email.size() > 3\r\n        && request.resource.data.email.size() <= 320\r\n           && request.resource.data.studentCount is string\r\n           && request.resource.data.studentCount.size() > 0\r\n           && request.resource.data.studentCount.size() <= 50\r\n        && request.resource.data.programType is string\r\n           && request.resource.data.programType.size() > 0\r\n           && request.resource.data.programType.size() <= 50\r\n           && (!('phone' in request.resource.data) || request.resource.data.phone is string)\r\n           && (!('message' in request.resource.data) || request.resource.data.message is string)\r\n           && request.resource.data.status == 'pending'\r\n        // Prevent mass-field injection — only allow known keys\r\n        && request.resource.data.keys().hasOnly([\r\n             'institutionName','contactName','email','phone',\r\n             'studentCount','programType','message','status','createdAt'\r\n           ]);\r\n      // Authenticated owner (matched by email) can read their own submission\r\n      allow read: if isSignedIn()\r\n        && request.auth.token.email != null\r\n        && resource.data.email == request.auth.token.email;\r\n      // Only admins may update (e.g. change status to 'contacted' / 'closed')\r\n      allow update: if isSuperAdmin() || isAdmin();\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Public Register Intake  (enriched self-registration profile)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /register/{registrationId} {\r\n      allow read: if isSuperAdmin() || isAdmin()\r\n        || (isSignedIn() && request.auth.uid == registrationId);\r\n\r\n      allow create: if isSignedIn()\r\n        && request.auth.uid == registrationId\r\n        && request.resource.data.uid == request.auth.uid\r\n        && request.resource.data.keys().hasAll([\r\n             'uid','fullName','email','phone','country','learnerType','examGoal','status','source'\r\n           ])\r\n        && request.resource.data.keys().hasOnly([\r\n             'uid','fullName','email','phone','country','learnerType','examGoal',\r\n             'organizationName','referralSource','goals','status','source','role','orgId',\r\n             'profileComplete','createdAt','updatedAt'\r\n           ]);\r\n\r\n      allow update: if (isSuperAdmin() || isAdmin())\r\n        || (\r\n          isSignedIn()\r\n          && request.auth.uid == registrationId\r\n          && request.resource.data.uid == resource.data.uid\r\n          && request.resource.data.status == resource.data.status\r\n          && request.resource.data.source == resource.data.source\r\n        );\r\n\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Tutors  (public profile directory)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /tutors/{tutorId} {\r\n      // Public read — active tutors are visible to everyone\r\n      allow read: if true;\r\n      // Only admins may manage tutor profiles\r\n      allow write: if isSuperAdmin() || isAdmin();\r\n\r\n      // Availability sub-collection (time slots per date)\r\n      match /availability/{slotId} {\r\n        allow read: if true;\r\n        allow write: if isSuperAdmin() || isAdmin();\r\n      }\r\n    }\r\n\r\n    // ──────────────────────────────────────────────────────────────────\r\n    // Tutor Bookings  (session requests from students)\r\n    // ──────────────────────────────────────────────────────────────────\r\n    match /tutor_bookings/{bookingId} {\r\n      allow read: if isSuperAdmin()\r\n        || isAdmin()\r\n        || (isSignedIn() && resource.data.studentId == request.auth.uid)\r\n        || (isSignedIn() && resource.data.tutorOwnerUid == request.auth.uid);\r\n      // Tutor session creation and state transitions are server-managed through Cloud Functions.\r\n      allow create, update: if false;\r\n      allow delete: if isSuperAdmin();\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-05-11T04:11:13.388591Z","metadata":{"services":["cloud.firestore"]}}
